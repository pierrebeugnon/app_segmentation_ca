SELECT 
    SUM(HDGPremiumPotentiel)  AS HDG_Premium_Potentiel,
    SUM(HDGPremiumStandard)   AS HDG_Premium_Standard,
    SUM(HDGPotentiel)         AS HDG_Potentiel,
    SUM(HDGSeniorEpargnant)   AS HDG_Senior_Epargnant,
    SUM(HDGStandard)          AS HDG_Standard,
    SUM(CIPotentiel)          AS CI_Potentiel,
    SUM(CIStandard)           AS CI_Standard,
    SUM(GPPotentiel)          AS GP_Potentiel,
    SUM(GPStandard)           AS GP_Standard,
    SUM(NonSegmente)          AS Non_Segmente,
    SUM(NonClasse)            AS Non_Classe,
    SUM(HDGPremiumPotentiel + HDGPremiumStandard + HDGPotentiel + HDGSeniorEpargnant 
        + HDGStandard + CIPotentiel + CIStandard + GPPotentiel + GPStandard 
        + NonSegmente + NonClasse) AS Total
FROM dbo.SegmentationDistributives
WHERE LibAgence = 'SOLESMES';



