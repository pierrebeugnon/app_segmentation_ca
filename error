@namespace Segmentation.Client.Components.Dashboard

<MudPaper Elevation="2" Style="border-radius:8px;overflow:hidden;margin-top:16px">
    <div class="ca-section-header">
        Suivi des transferts entre Agences, Banque Privée et Portefeuilles Mutualisés
        <MudTooltip Text="Un badge rouge signale un écart entre ce qui est déclaré d'un côté et confirmé de l'autre — transfert potentiellement en attente.">
            <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Style="color:rgba(255,255,255,0.65);margin-left:8px" />
        </MudTooltip>
    </div>

    @if (!Segments.Any())
    {
        <MudAlert Severity="Severity.Info" Class="ma-3">Aucune donnée de transfert disponible pour ce périmètre.</MudAlert>
    }
    else
    {
        <div style="overflow-x:auto">
            <table class="ca-transfert-table" style="width:100%;border-collapse:collapse;font-size:12px">
                <thead>
                    <tr>
                        <th rowspan="2" style="background:#0A1F30;color:white;padding:8px 12px;text-align:left;min-width:160px">Segments distributifs</th>
                        <th colspan="2" style="background:#1A6B3C;color:white;padding:6px;text-align:center">Clients transférés vers la Banque Privée</th>
                        <th colspan="2" style="background:#2D6E86;color:white;padding:6px;text-align:center">Clients transférés vers les Agences</th>
                        <th colspan="2" style="background:#4A5A6E;color:white;padding:6px;text-align:center">Clients transférés en portefeuille mutualisé</th>
                    </tr>
                    <tr>
                        <th style="background:#155C33;color:white;padding:6px;font-weight:400;font-size:10px">Déclarés (agences)</th>
                        <th style="background:#155C33;color:white;padding:6px;font-weight:400;font-size:10px">Réceptionnés (BP)</th>
                        <th style="background:#255F76;color:white;padding:6px;font-weight:400;font-size:10px">Déclarés (BP)</th>
                        <th style="background:#255F76;color:white;padding:6px;font-weight:400;font-size:10px">Réceptionnés (agences)</th>
                        <th style="background:#3E4C5E;color:white;padding:6px;font-weight:400;font-size:10px">Déclarés (agences + BP)</th>
                        <th style="background:#3E4C5E;color:white;padding:6px;font-weight:400;font-size:10px">Placés (mutualisé)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var seg in Segments)
                    {
                        var ligne = GetLigne(seg);
                        <tr style="border-bottom:1px solid #EEE">
                            <td style="padding:6px 12px;font-style:italic;color:#1A4E6B">@seg</td>
                            @RenderCell(ligne.DeclareBP, ligne.ReceptionneBP, IsHdgPremium(seg))
                            @RenderCell(ligne.DeclareAgence, ligne.ReceptionneAgence, IsSegmentActionnable(seg) && !IsHdgPremium(seg))
                            @RenderCell(ligne.DeclareMutualise, ligne.PlaceMutualise, IsGpStandard(seg))
                        </tr>
                    }
                    <tr style="background:#F0F4FA;font-weight:700">
                        <td style="padding:6px 12px">TOTAL</td>
                        @{ var totalLigne = GetTotal(); }
                        @RenderCell(totalLigne.DeclareBP, totalLigne.ReceptionneBP, true)
                        @RenderCell(totalLigne.DeclareAgence, totalLigne.ReceptionneAgence, true)
                        @RenderCell(totalLigne.DeclareMutualise, totalLigne.PlaceMutualise, true)
                    </tr>
                </tbody>
            </table>
        </div>
    }
</MudPaper>

@code {
    [Parameter] public List<DimensionnementPortefeuilleEtpAllCharge> Charges { get; set; } = new();
    [Parameter] public string? FiltreRegion { get; set; }
    [Parameter] public string? FiltreSecteur { get; set; }
    [Parameter] public string? FiltreAgence { get; set; }

    private static readonly List<string> Segments = new()
    {
        "HDG Premium Potentiel", "HDG Premium Standard", "HDG Potentiel",
        "HDG Senior Epargnant", "HDG Standard", "CI Potentiel",
        "CI Standard", "GP Potentiel", "GP Standard"
    };

    private static bool IsHdgPremium(string segment) => segment.Contains("Premium", StringComparison.OrdinalIgnoreCase);
    private static bool IsGpStandard(string segment) => segment.Equals("GP Standard", StringComparison.OrdinalIgnoreCase);
    private static bool IsSegmentActionnable(string segment) =>
        !segment.Equals("Non segmenté", StringComparison.OrdinalIgnoreCase) &&
        !segment.Equals("Non classé", StringComparison.OrdinalIgnoreCase);

    private List<DimensionnementPortefeuilleEtpAllCharge> FiltreesParPerimetre() =>
        Charges
            .Where(c => string.IsNullOrEmpty(FiltreRegion) || c.LibRegion == FiltreRegion)
            .Where(c => string.IsNullOrEmpty(FiltreSecteur) || c.LibSecteur == FiltreSecteur)
            .Where(c => string.IsNullOrEmpty(FiltreAgence) || c.LibAgence == FiltreAgence)
            .ToList();

    private static bool EstBanquePrivee(DimensionnementPortefeuilleEtpAllCharge c) =>
        c.LibSecteur?.Contains("Banque", StringComparison.OrdinalIgnoreCase) == true;

    private static bool EstMutualise(DimensionnementPortefeuilleEtpAllCharge c) =>
        c.LibAgence?.Contains("Portefeuille mutualisé", StringComparison.OrdinalIgnoreCase) == true;

    private (double DeclareBP, double ReceptionneBP, double DeclareAgence, double ReceptionneAgence, double DeclareMutualise, double PlaceMutualise) GetLigne(string segment)
    {
        var data = FiltreesParPerimetre().Where(c => c.Segment.Equals(segment, StringComparison.OrdinalIgnoreCase)).ToList();

        var declareBP = data.Where(c => !EstBanquePrivee(c) && !EstMutualise(c)).Sum(c => c.ChargeATransfererBP ?? 0);
        var receptionneBP = data.Where(c => EstBanquePrivee(c)).Sum(c => c.ChargeATransfererBP ?? 0);

        var declareAgence = data.Where(c => !EstBanquePrivee(c) && !EstMutualise(c)).Sum(c => c.ChargeRecueBP ?? 0);
        var receptionneAgence = data.Where(c => EstBanquePrivee(c)).Sum(c => c.ChargeRecueBP ?? 0);

        var declareMutualise = data.Where(c => !EstMutualise(c)).Sum(c => c.ChargeATransfererMutualise ?? 0);
        var placeMutualise = data.Where(c => EstMutualise(c)).Sum(c => c.ChargeATransfererMutualise ?? 0);

        return (declareBP, receptionneBP, declareAgence, receptionneAgence, declareMutualise, placeMutualise);
    }

    private (double DeclareBP, double ReceptionneBP, double DeclareAgence, double ReceptionneAgence, double DeclareMutualise, double PlaceMutualise) GetTotal()
    {
        double dBP = 0, rBP = 0, dAg = 0, rAg = 0, dMut = 0, pMut = 0;
        foreach (var seg in Segments)
        {
            var l = GetLigne(seg);
            dBP += l.DeclareBP; rBP += l.ReceptionneBP;
            dAg += l.DeclareAgence; rAg += l.ReceptionneAgence;
            dMut += l.DeclareMutualise; pMut += l.PlaceMutualise;
        }
        return (dBP, rBP, dAg, rAg, dMut, pMut);
    }

    private RenderFragment RenderCell(double a, double b, bool applicable) => builder =>
    {
        if (!applicable)
        {
            builder.OpenElement(0, "td");
            builder.AddAttribute(1, "style", "text-align:center;padding:6px;color:#BDBDBD");
            builder.AddContent(2, "—");
            builder.CloseElement();
            builder.OpenElement(3, "td");
            builder.AddAttribute(4, "style", "text-align:center;padding:6px;color:#BDBDBD");
            builder.AddContent(5, "—");
            builder.CloseElement();
            return;
        }

        var ecart = Math.Abs(a - b) > 0.01;
        var couleur = ecart ? "#C62828" : "#2E7D32";
        var fond = ecart ? "#FFEBEE" : "#E8F5E9";

        builder.OpenElement(0, "td");
        builder.AddAttribute(1, "style", $"text-align:center;padding:6px;background:{fond};color:{couleur};font-weight:600");
        builder.AddContent(2, a.ToString("F0"));
        builder.CloseElement();

        builder.OpenElement(3, "td");
        builder.AddAttribute(4, "style", $"text-align:center;padding:6px;background:{fond};color:{couleur};font-weight:600");
        builder.AddContent(5, b.ToString("F0"));
        builder.CloseElement();
    };
}
