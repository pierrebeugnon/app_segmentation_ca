    // ── Mutations ─────────────────────────────────────────────────────────
    private void SetEtpCible(DimMatrixRow row, string slotId, double? value)
    {
        row.EtpCibleSaisieParProfil[slotId] = value;
        RecalcTotal();
    }

    private void RecalcTotal()
    {
        var totalRow = rows.LastOrDefault(r => r.IsTotal);
        if (totalRow == null) return;

        foreach (var slot in _slots)
        {
            var valsExist = rows
                .Where(r => !r.IsTotal)
                .Select(r => r.EtpParProfil.GetValueOrDefault(slot.Id))
                .ToList();

            var valsCible = rows
                .Where(r => !r.IsTotal)
                .Select(r => r.EtpCibleSaisieParProfil.GetValueOrDefault(slot.Id))
                .ToList();

            totalRow.EtpParProfil[slot.Id] =
                valsExist.Any(v => v.HasValue)
                    ? valsExist.Sum(v => v ?? 0)
                    : null;

            totalRow.EtpCibleSaisieParProfil[slot.Id] =
                valsCible.Any(v => v.HasValue)
                    ? valsCible.Sum(v => v ?? 0)
                    : null;
        }

        filteredRows = rows.ToList();
    }

    // ── Affichage ETP / Nombre de clients ─────────────────────────────────
    private double? ToDisplayValue(double? etpValue, string segment) =>
        vueEtp ? etpValue : EtpService.GetClientCountFromEtp(etpValue, segment, StateService.Regles);

    private string FormatDisplay(double? etpValue, string segment, string etpFormat = "F2")
    {
        var v = ToDisplayValue(etpValue, segment);
        if (v is null) return "—";
        var format = !vueEtp || (v.Value % 1) == 0 ? "F0" : etpFormat;
        return v.Value.ToString(format);
    }

    private string FormatTotal(double? value)
    {
        if (value is null) return "—";

        // En vue "Nombre de clients", toujours un entier arrondi — jamais de décimales.
        if (!vueEtp)
            return Math.Round(value.Value).ToString("F0");

        var format = Math.Abs(value.Value % 1) < 0.001 ? "F0" : "F2";
        return value.Value.ToString(format);
    }

    private double? GetDisplayTotalForSlot(string slotId, bool cible)
    {
        // Existant en vue "Nombre de clients" : comptage réel direct
        // (jamais reconverti depuis l'ETP), pour que ce total corresponde
        // toujours exactement à la somme des cellules affichées.
        if (!cible && !vueEtp)
        {
            var slot = _slots.FirstOrDefault(s => s.Id == slotId);
            return slot != null ? GetRealClientCountTotalForSlot(slot) : null;
        }

        return rows.Where(r => !r.IsTotal)
                 .Sum(r => ToDisplayValue(
                     cible ? r.EtpCibleSaisieParProfil.GetValueOrDefault(slotId)
                           : r.EtpParProfil.GetValueOrDefault(slotId),
                     r.Segment));
    }

    private double? GetDisplayProfilTotal(string profil, bool cible)
    {
        return _slots.Where(s => s.Profil.Equals(profil, StringComparison.OrdinalIgnoreCase))
                     .Sum(s => GetDisplayTotalForSlot(s.Id, cible) ?? 0);
    }

    private double? GetDisplayRowTotal(DimMatrixRow row, bool cible)
    {
        // Existant en vue "Nombre de clients" : comptage réel direct sur
        // TOUTE l'agence (pas seulement les conseillers affichés dans
        // _slots) — inclut donc les clients rattachés à des conseillers
        // exclus des colonnes (ex. "NON REPARTI"), pour que ce total
        // corresponde exactement au comptage brut en base.
        if (!cible && !vueEtp)
        {
            return GetRealClientCountAgenceTotal();
        }

        // Appelée uniquement pour la ligne Total : on ne peut pas convertir une
        // valeur déjà sommée cross-segments avec row.Segment (qui n'est pas un
        // vrai segment ici). On reconstruit donc le total en sommant, pour
        // chaque VRAI segment, sa valeur convertie individuellement — cohérent
        // avec GetDisplayTotalForSlot.
        var keys = (cible ? _slots.Where(s => s.IsCible) : _slots)
            .Select(s => s.Id)
            .ToHashSet();

        return rows.Where(r => !r.IsTotal)
            .Sum(r =>
            {
                var dict = cible ? r.EtpCibleSaisieParProfil : r.EtpParProfil;
                return dict.Where(kv => keys.Contains(kv.Key))
                           .Sum(kv => ToDisplayValue(kv.Value, r.Segment));
            });
    }

    /// <summary>
    /// Total de la charge ETP/clients "ajustée" (existant ± transferts BP/Agence/
    /// Mutualisé), sommée sur tous les segments — utilisé comme référence cible
    /// dans la ligne Total : avant toute redistribution manuelle entre
    /// conseillers, la cible logique à couvrir est cette charge ajustée, pas la
    /// somme des saisies individuelles déjà réparties dans le tableau.
    /// </summary>
    private double? GetChargeAjusteeTotal()
    {
        return rows.Where(r => !r.IsTotal)
            .Sum(r => ToDisplayValue(GetChargeTotaleAffichee(r), r.Segment));
    }


    private static string GetExistantColor(double? existant, double? _ = null) =>
        (!existant.HasValue || existant.Value <= 0) ? "color:#9AA5B1" : "color:#E65100;font-weight:600";

    private double? GetCoverageDiff(DimMatrixRow row)
    {
        if (row.IsTotal) return null;
        var activeSlots = _slots.Where(s => s.IsCible).ToList();
        var totalCible = activeSlots.Sum(s => row.EtpCibleSaisieParProfil.GetValueOrDefault(s.Id) ?? 0);
        // On compare à la charge ajustée (après transferts), pas à la charge
        // brute existante — cohérent avec la colonne "Charge Totale ETP par
        // segment" affichée juste à côté.
        var totalExist = GetChargeTotaleAffichee(row) ?? 0;
        if (totalCible <= 0 && totalExist <= 0) return null;
        return totalCible - totalExist;
    }

    private double? GetDisplayCoverageDiff(DimMatrixRow row)
    {
        if (row.IsTotal) return null;
        var activeSlots = _slots.Where(s => s.IsCible).ToList();
        var totalCib = activeSlots.Sum(s => EtpService.GetClientCountFromEtp(row.EtpCibleSaisieParProfil.GetValueOrDefault(s.Id), row.Segment, StateService.Regles) ?? 0);
        var totalExist = EtpService.GetClientCountFromEtp(GetChargeTotaleAffichee(row), row.Segment, StateService.Regles) ?? 0;
        if (totalCib <= 0 && totalExist <= 0) return null;
        return totalCib - totalExist;
    }


    private (double? pct, string color, string tooltip) GetConcordance(DimMatrixRow row)
    {
        if (row.IsTotal) return (null, "", "");
        var activeSlots = _slots.Where(s => s.IsCible).ToList();
        var totalCible  = activeSlots.Sum(s => row.EtpCibleSaisieParProfil.GetValueOrDefault(s.Id) ?? 0);
        if (totalCible <= 0) return (null, "", "Aucune saisie");

        var etpDesigne    = activeSlots
            .Where(s => GetAssignmentLevel(row.Segment, s.Profil) > 0)
            .Sum(s => row.EtpCibleSaisieParProfil.GetValueOrDefault(s.Id) ?? 0);
        var etpHorsRH     = totalCible - etpDesigne;

        var etpPrio  = activeSlots.Where(s => GetAssignmentLevel(row.Segment, s.Profil) == 1).Sum(s => row.EtpCibleSaisieParProfil.GetValueOrDefault(s.Id) ?? 0);
        var etpSec   = activeSlots.Where(s => GetAssignmentLevel(row.Segment, s.Profil) == 2).Sum(s => row.EtpCibleSaisieParProfil.GetValueOrDefault(s.Id) ?? 0);
        var etpTert  = activeSlots.Where(s => GetAssignmentLevel(row.Segment, s.Profil) == 3).Sum(s => row.EtpCibleSaisieParProfil.GetValueOrDefault(s.Id) ?? 0);

        var pct   = etpDesigne / totalCible * 100.0;
        var color = pct >= 99.9 ? "color:#2E7D32;font-weight:700" :
                    pct >= 80   ? "color:#E65100;font-weight:700" :
                                  "color:#C62828;font-weight:700";

        var tooltip = $"Concordance : {pct:F0}% dans les types de segments\n" +
                      $"  ▸ Prioritaire  : {etpPrio:F2} ETP\n" +
                      $"  ▸ Secondaire   : {etpSec:F2} ETP\n" +
                      $"  ▸ Tertiaire    : {etpTert:F2} ETP\n" +
                      $"  ✗ Hors priorité     : {etpHorsRH:F2} ETP";

        return (pct, color, tooltip);
    }

    private (double? pct, string color, string tooltip) GetConcordanceExistant(DimMatrixRow row)
    {
        if (row.IsTotal) return (null, "", "");
        var allSlots = _slots.ToList();
        var totalExist = allSlots.Sum(s => row.EtpParProfil.GetValueOrDefault(s.Id) ?? 0);
        if (totalExist <= 0) return (null, "", "Aucune donnée existante");

        var etpDesigne = allSlots
            .Where(s => GetAssignmentLevel(row.Segment, s.Profil) > 0)
            .Sum(s => row.EtpParProfil.GetValueOrDefault(s.Id) ?? 0);
        var etpHorsRH = totalExist - etpDesigne;

        var etpPrio = allSlots.Where(s => GetAssignmentLevel(row.Segment, s.Profil) == 1).Sum(s => row.EtpParProfil.GetValueOrDefault(s.Id) ?? 0);
        var etpSec = allSlots.Where(s => GetAssignmentLevel(row.Segment, s.Profil) == 2).Sum(s => row.EtpParProfil.GetValueOrDefault(s.Id) ?? 0);
        var etpTert = allSlots.Where(s => GetAssignmentLevel(row.Segment, s.Profil) == 3).Sum(s => row.EtpParProfil.GetValueOrDefault(s.Id) ?? 0);

        var pct = etpDesigne / totalExist * 100.0;
        var color = pct >= 99.9 ? "color:#2E7D32;font-weight:700" :
                    pct >= 80   ? "color:#E65100;font-weight:700" :
                                  "color:#C62828;font-weight:700";

        var tooltip = $"Concordance existant : {pct:F0}% dans les types de segments\n" +
                      $"  ▸ Prioritaire  : {etpPrio:F2} ETP\n" +
                      $"  ▸ Secondaire   : {etpSec:F2} ETP\n" +
                      $"  ▸ Tertiaire    : {etpTert:F2} ETP\n" +
                      $"  ✗ Hors priorité     : {etpHorsRH:F2} ETP";

        return (pct, color, tooltip);
    }

