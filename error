double totalChargeEtp = 0;
foreach (var t in TaillesCalculees.Where(x => !IsSegmentNonAffectable(x.SegmentCouvert)))
{
    if (IsSegmentNonRenseigne(t.SegmentCouvert)) continue;
    var tailleT = CalculService.GetTailleTheoriqueParSegment(model, t.SegmentCouvert);
    var nbT = _segmentationDistributive.Sum(x => EtpService.GetClientCountForSegment(x, t.SegmentCouvert));
    if (tailleT > 0) totalChargeEtp += nbT / tailleT;
}
