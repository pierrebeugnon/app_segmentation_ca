                         .Where(v => v.HasValue).ToList();
        return vals.Any() ? vals.Sum(v => v!.Value) : null;
    }

    private double? GetRowExistantTotal(DimMatrixRow row)
    {
        var vals = _slots.Select(s => row.EtpParProfil.GetValueOrDefault(s.Id))
