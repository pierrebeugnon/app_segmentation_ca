            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Where(x => !x.Trim().Equals("NON REPARTI", StringComparison.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();
    }

    private async Task ApplyFilters()
    {
        _isLoading = true;
        StateHasChanged();

        await Task.Delay(1);

        try
        {
            BuildFilterOptions();

            // Les secteurs Banque Privée n'ont pas de véritable subdivision par
            // agence : la seule "agence" présente en base est un portefeuille
            // mutualisé de secteur, qu'il ne faut pas sélectionner par défaut.
            // Dans ce cas, on laisse l'agence vide — AgenceEffective retombera
            // sur le secteur comme clé de sauvegarde/restauration.
            _estSecteurBanquePrivee = filtreSecteur?.Contains("Banque", StringComparison.OrdinalIgnoreCase) == true;

            if (string.IsNullOrEmpty(filtreAgence) && allAgences.Any() && !_estSecteurBanquePrivee)
            {
                filtreAgence = allAgences.First();
            }

            _estPortefeuilleMutualise = filtreAgence?.Contains("Portefeuille mutualisé", StringComparison.OrdinalIgnoreCase) == true;

            _segmentationDistributiveFiltree = _segmentationDistributive
                .Where(x => string.IsNullOrEmpty(filtreRegion) || x.LibRegion == filtreRegion)
                .Where(x => string.IsNullOrEmpty(filtreSecteur) || x.LibSecteur == filtreSecteur)
                .Where(x => string.IsNullOrEmpty(filtreAgence) || x.LibAgence == filtreAgence)
                .ToList();

            filtreRegionApplique = filtreRegion;
            filtreSecteurApplique = filtreSecteur;
            filtreAgenceApplique = filtreAgence;

            // Reset des charges manuelles quand on change d'agence
            _chargeATransfererBP.Clear();
            _chargeRecueBP.Clear();
            _chargeATransfererMutualise.Clear();

            _slots = BuildSlots();
            rows = BuildRows();

            RecalcTotal();

            // Tente de restaurer une sauvegarde existante pour cette agence.
            // Doit s'exécuter AVANT le calcul de `profils` ci-dessous : c'est
            // elle qui peut ajouter à _slots des conseillers créés
            // manuellement lors d'une sauvegarde précédente (sans matricule,
            // donc absents de BuildSlots()).
            await RestaurerSauvegardeEtp();

            // Un profil obtient une colonne dans le tableau de charges dès
            // qu'au moins un conseiller de ce type existe dans _slots — que
            // ce soit un conseiller réel (matricule) ou restauré depuis une
            // sauvegarde précédente (ajouté manuellement).
            profils = _slots
                .Select(s => s.Profil)
                .Where(p => !string.IsNullOrWhiteSpace(p))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(p => p)
                .ToList();

            filteredRows = rows.ToList();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Recherche une sauvegarde ETP existante pour l'agence sélectionnée.
    /// Si aucune sauvegarde n'existe, la proposition calculée automatiquement
    /// (déjà construite par BuildSlots/BuildRows) est conservée telle quelle.
    /// Si une sauvegarde existe, restaure les conseillers ajoutés/retirés,
    /// les états IsActuel/IsCible, les capacités et les valeurs cibles saisies,
    /// ainsi que les charges manuelles.
    /// </summary>
    private async Task RestaurerSauvegardeEtp()
    {
        if (string.IsNullOrWhiteSpace(AgenceEffective))
            return;

        var sauvegarde = await DimensionnementEtpService.GetAsync(AgenceEffective);

        if (sauvegarde is null)
        {
            // Aucune sauvegarde : on garde la proposition calculée.
            return;
        }

        // ── Restauration des conseillers (slots) ────────────────────────────
        // Regroupe les lignes sauvegardées par conseiller (Matricule+Profil,
        // ou SlotLabel en clé de secours pour les ajouts manuels sans matricule).
        var lignesParConseiller = sauvegarde.Lignes
            .GroupBy(l => GetCleConseiller(l.MatriculeConseiller, l.ProfilConseiller, l.SlotLabel))
            .ToList();

        foreach (var groupe in lignesParConseiller)
        {
            var premiereLigne = groupe.First();

            var slotExistant = _slots.FirstOrDefault(s =>
                GetCleConseiller(GetMatriculeForSlot(s), s.Profil, s.Label) == groupe.Key);

            if (slotExistant != null)
            {
                // Conseiller déjà présent dans la proposition calculée :
                // on restaure simplement ses états et capacités.
                slotExistant.IsActuel = premiereLigne.IsActuel;
                slotExistant.IsCible = premiereLigne.IsCible;
                slotExistant.EtpActuel = premiereLigne.CapaciteEtpActuel;
                slotExistant.EtpCible = premiereLigne.CapaciteEtpCible;
            }
            else
            {
                // Conseiller absent de la proposition calculée (ex. ajouté
                // manuellement lors d'une sauvegarde précédente, ou retiré
                // depuis de la source SegmentationDistributive) : on le recrée.
                var nouveauSlot = new ConseillerSlot
                {
                    Profil = premiereLigne.ProfilConseiller,
                    Label = premiereLigne.SlotLabel,
                    IsActuel = premiereLigne.IsActuel,
                    IsCible = premiereLigne.IsCible,
                    EtpActuel = premiereLigne.CapaciteEtpActuel,
                    EtpCible = premiereLigne.CapaciteEtpCible
                };

                _slots.Add(nouveauSlot);

                foreach (var row in rows)
                {
                    row.EtpParProfil[nouveauSlot.Id] = null;
                    row.EtpCibleSaisieParProfil[nouveauSlot.Id] = null;
                }
            }
        }

        // ── Restauration des valeurs par segment × conseiller ───────────────
        foreach (var ligne in sauvegarde.Lignes)
        {
            var cle = GetCleConseiller(ligne.MatriculeConseiller, ligne.ProfilConseiller, ligne.SlotLabel);

            var slot = _slots.FirstOrDefault(s =>
                GetCleConseiller(GetMatriculeForSlot(s), s.Profil, s.Label) == cle);

            if (slot is null)
                continue;

            var row = rows.FirstOrDefault(r => !r.IsTotal &&
                r.Segment.Equals(ligne.Segment, StringComparison.OrdinalIgnoreCase));

            if (row is null)
                continue;

            row.EtpCibleSaisieParProfil[slot.Id] = ligne.EtpCible;
        }

        // ── Restauration des charges manuelles ──────────────────────────────
        foreach (var charge in sauvegarde.Charges)
        {
            if (charge.ChargeATransfererBP.HasValue)
                _chargeATransfererBP[charge.Segment] = charge.ChargeATransfererBP;

            if (charge.ChargeRecueBP.HasValue)
                _chargeRecueBP[charge.Segment] = charge.ChargeRecueBP;

            if (charge.ChargeATransfererMutualise.HasValue)
                _chargeATransfererMutualise[charge.Segment] = charge.ChargeATransfererMutualise;
        }

        RecalcTotal();
    }

    /// <summary>
    /// Clé d'identification d'un conseiller pour le rapprochement sauvegarde/proposition.
    /// Priorité : Matricule + Profil. Clé de secours : SlotLabel (pour un conseiller
    /// ajouté manuellement sans matricule, ex. un nouveau poste non pourvu).
    /// </summary>
    private static string GetCleConseiller(string? matricule, string profil, string slotLabel)
    {
        return !string.IsNullOrWhiteSpace(matricule)
            ? $"M:{matricule}|{profil}".ToUpperInvariant()
            : $"L:{slotLabel}".ToUpperInvariant();
    }

    /// <summary>
    /// Segments dont la répartition cible a été commencée (au moins une valeur
    /// saisie) mais n'est pas terminée (la somme des cibles ne couvre pas
    /// exactement la charge à répartir — "Aide à la répartition" différente
    /// de OK). Les segments jamais touchés (aucune saisie) ne sont pas
    /// concernés par cette règle.
    /// </summary>
    private List<string> GetSegmentsRepartitionIncomplete()
    {
        return rows
            .Where(r => !r.IsTotal)
            .Where(r => (GetRowCibleTotal(r) ?? 0) > 0.001)
            .Where(r =>
            {
                var diff = GetCoverageDiff(r);
                return diff.HasValue && Math.Abs(diff.Value) > 0.01;
            })
            .Select(r => r.Segment)
            .ToList();
    }

    private async Task EnregistrerDimensionnementEtp()
    {
        if (string.IsNullOrWhiteSpace(AgenceEffective))
        {
            Snackbar.Add("Sélectionnez une agence ou un secteur avant d'enregistrer.", Severity.Warning);
            return;
        }

        var segmentsIncomplets = GetSegmentsRepartitionIncomplete();
        if (segmentsIncomplets.Any())
        {
            Snackbar.Add(
                $"Répartition incomplète sur : {string.Join(", ", segmentsIncomplets)}. " +
                "Terminez la répartition de la charge cible sur ces segments avant d'enregistrer.",
                Severity.Warning);
            return;
        }

        _isSaving = true;
        StateHasChanged();

        try
        {
            var request = new SaveDimensionnementPortefeuilleEtpRequest
            {
                LibRegion = filtreRegion,
                LibSecteur = filtreSecteur,
                LibAgence = AgenceEffective,
                Lignes = BuildLignesRequest(),
                Charges = BuildChargesRequest()
            };

            var success = await DimensionnementEtpService.SaveAsync(request);

            Snackbar.Add(
                success
                    ? "Dimensionnement ETP enregistré avec succès."
                    : "Erreur lors de l'enregistrement du dimensionnement ETP.",
                success ? Severity.Success : Severity.Error);
        }
        catch (Exception ex)
        {
            Console.WriteLine($">>> Erreur EnregistrerDimensionnementEtp : {ex.Message}");
            Snackbar.Add("Une erreur inattendue est survenue lors de l'enregistrement.", Severity.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private List<SaveDimensionnementPortefeuilleEtpLigneRequest> BuildLignesRequest()
    {
        var lignes = new List<SaveDimensionnementPortefeuilleEtpLigneRequest>();

        foreach (var row in rows.Where(r => !r.IsTotal))
        {
            foreach (var slot in _slots)
            {
                lignes.Add(new SaveDimensionnementPortefeuilleEtpLigneRequest
                {
                    Segment = row.Segment,
                    ProfilConseiller = slot.Profil,
                    MatriculeConseiller = GetMatriculeForSlot(slot),
                    SlotLabel = slot.Label,
                    IsActuel = slot.IsActuel,
                    IsCible = slot.IsCible,
                    EtpExistant = row.EtpParProfil.GetValueOrDefault(slot.Id),
                    EtpCible = row.EtpCibleSaisieParProfil.GetValueOrDefault(slot.Id),
                    CapaciteEtpActuel = slot.EtpActuel,
                    CapaciteEtpCible = slot.EtpCible
                });
            }
        }

        return lignes;
    }

    private List<SaveDimensionnementPortefeuilleEtpChargeRequest> BuildChargesRequest()
    {
        return segments
            .Select(s => new SaveDimensionnementPortefeuilleEtpChargeRequest
            {
                Segment = s,
                ChargeATransfererBP = _chargeATransfererBP.GetValueOrDefault(s),
                ChargeRecueBP = _chargeRecueBP.GetValueOrDefault(s),
                ChargeATransfererMutualise = _chargeATransfererMutualise.GetValueOrDefault(s)
            })
            .ToList();
    }

    /// <summary>
    /// Récupère le matricule d'un conseiller pour la clé de persistance,
    /// uniquement s'il correspond à un vrai matricule présent dans la source
    /// (et non un numéro de slot ajouté manuellement, ex. "COM-3").
    /// </summary>
    private string? GetMatriculeForSlot(ConseillerSlot slot)
    {
        var candidate = ExtractMatriculeFromSlotLabel(slot.Label);

        var existeDansSource = _segmentationDistributiveFiltree.Any(x =>
            x.TypeConseiller.Equals(slot.Profil, StringComparison.OrdinalIgnoreCase) &&
            x.MatriculeConseiller == candidate);

        return existeDansSource ? candidate : null;
    }

