    /// <summary>
    /// S'assure que les Règles & Hypothèses sont chargées depuis la base
    /// avant que la page Portefeuille les utilise. Nécessaire quand
    /// l'utilisateur arrive directement sur /portefeuille sans être
    /// passé par /regles-hypotheses au préalable.
    /// </summary>
    private async Task EnsureReglesLoadedAsync()
    {
        if (StateService.IsLoaded)
            return;

        try
        {
            var bundle = await ReglesService.LoadAllAsync();

            var reglesModel = new ReglesHypothesesModel
            {
                HeuresParSemaine = bundle.Parametres?.HeuresParSemaine ?? 0,
                NbSemainesParAn = bundle.Parametres?.NbSemainesParAn ?? 0,

                SegmentsIntensite = bundle.Segments.Where(x => !EstNonReparti(x.Segment)).Select(x => new SegmentIntensite
                {
                    LigneMetier = x.LigneMetier,
                    Segment = x.Segment,
                    NombreRdvParAn = x.NombreRdvParAn,
                    DureeRdvHeures = x.DureeRdvHeures
                }).ToList(),

                ConseillersProfils = bundle.Profils.Where(x => !EstNonReparti(x.Profil) && !EstNonReparti(x.LigneMetier)).Select(x => new ConseillerTempsProfil
                {
                    LigneMetier = x.LigneMetier,
                    Profil = x.Profil,
                    PartTempsCommercialPct = x.PartTempsCommercialPct
                }).ToList(),

                ReglesAffectationSegments = bundle.Regles.Where(x => !EstNonReparti(x.Segment)).Select(x => new RegleAffectationSegment
                {
                    Segment = x.Segment,
                    ConseillerPrioritaire = x.ConseillerPrioritaire,
                    ConseillerSecondaire = x.ConseillerSecondaire,
                    ConseillerTertiaire = x.ConseillerTertiaire
                }).ToList()
            };

            StateService.UpdateRegles(reglesModel);

            Console.WriteLine(
                $">>> Règles chargées depuis Portefeuille : " +
                $"{reglesModel.SegmentsIntensite.Count} segments, " +
                $"{reglesModel.ConseillersProfils.Count} profils, " +
                $"{reglesModel.ReglesAffectationSegments.Count} règles");
        }
        catch (Exception ex)
        {
            Console.WriteLine($">>> Erreur chargement Règles depuis Portefeuille : {ex.Message}");
        }
    }

    // ── Lifecycle ─────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        try
        {
            StateService.OnChange += OnReglesChanged;

            await EnsureReglesLoadedAsync();

            _segmentationDistributive = await Http.GetFromJsonAsync<List<SegmentationDistributiveData>>(
                "api/SegmentationDistributive"
            ) ?? new();

            Console.WriteLine($">>> SegmentationDistributive chargée : {_segmentationDistributive.Count} lignes");

            filtreRegion = _segmentationDistributive
                .Select(x => x.LibRegion)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .OrderBy(x => x)
                .FirstOrDefault();

            filtreSecteur = _segmentationDistributive
                .Where(x => string.IsNullOrEmpty(filtreRegion) || x.LibRegion == filtreRegion)
                .Select(x => x.LibSecteur)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .OrderBy(x => x)
                .FirstOrDefault();

            filtreAgence = _segmentationDistributive
                .Where(x => string.IsNullOrEmpty(filtreRegion) || x.LibRegion == filtreRegion)
                .Where(x => string.IsNullOrEmpty(filtreSecteur) || x.LibSecteur == filtreSecteur)
                .Select(x => x.LibAgence)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .OrderBy(x => x)
                .FirstOrDefault();

            _segmentationDistributiveFiltree = _segmentationDistributive
                .Where(x => string.IsNullOrEmpty(filtreRegion) || x.LibRegion == filtreRegion)
                .Where(x => string.IsNullOrEmpty(filtreSecteur) || x.LibSecteur == filtreSecteur)
                .Where(x => string.IsNullOrEmpty(filtreAgence) || x.LibAgence == filtreAgence)
                .ToList();

            filtreRegionApplique = filtreRegion;
            filtreSecteurApplique = filtreSecteur;
            filtreAgenceApplique = filtreAgence;

            BuildFilterOptions();
            await InitData();

            Console.WriteLine($">>> Agence par défaut : {filtreAgence}");
            Console.WriteLine($">>> Lignes filtrées : {_segmentationDistributiveFiltree.Count}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur chargement Portefeuille : {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

