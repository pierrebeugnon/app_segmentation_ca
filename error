namespace Segmentation.Shared.Referentiels
{
    /// <summary>
    /// Source de vérité UNIQUE de l'ordre métier des segments distributifs.
    ///
    /// À utiliser partout où une liste de segments doit être triée
    /// (page Portefeuille, volets Règles & Hypothèses, Dashboard, handler référentiel…)
    /// afin de garantir un ordre identique sur tous les écrans.
    ///
    /// ⚠️ Ne jamais retrier les segments avec un simple OrderBy(x => x.Segment) :
    ///    cela produit un ordre ALPHABÉTIQUE (CI avant HDG) qui casse l'ordre métier.
    ///    Toujours passer par OrdreSegments.IndexDe(...).
    /// </summary>
    public static class OrdreSegments
    {
        // ═══════════════════════════════════════════════════════════════
        //   Ordre métier de référence des segments distributifs
        //   (ordre officiel CA NDF — ne pas trier alphabétiquement)
        // ═══════════════════════════════════════════════════════════════
        public static readonly IReadOnlyList<string> Ordre = new List<string>
        {
            "HDG Premium Potentiel",
            "HDG Premium Standard",
            "HDG Potentiel",
            "HDG Senior Epargnant",
            "HDG Standard",
            "CI Potentiel",
            "CI Standard",
            "GP Potentiel",
            "GP Standard",
            "Non segmenté",
            "Non classé"
        };

        /// <summary>
        /// Retourne l'index de tri d'un segment selon l'ordre métier de référence.
        /// Un segment inconnu (non référencé, faute de frappe, nouvelle donnée)
        /// est renvoyé en FIN de liste plutôt que de casser le tri.
        /// </summary>
        /// <param name="segment">Libellé du segment (les espaces de bord sont ignorés).</param>
        /// <returns>Position dans <see cref="Ordre"/>, ou int.MaxValue si non trouvé.</returns>
        public static int IndexDe(string? segment)
        {
            if (string.IsNullOrWhiteSpace(segment))
                return int.MaxValue;

            var cible = segment.Trim();

            for (int i = 0; i < Ordre.Count; i++)
            {
                if (string.Equals(Ordre[i], cible, StringComparison.OrdinalIgnoreCase))
                    return i;
            }

            return int.MaxValue; // segments non référencés à la fin
        }

        /// <summary>
        /// Trie une séquence d'éléments selon l'ordre métier des segments.
        /// Pratique pour éviter de réécrire le OrderBy(x => IndexDe(...)) partout.
        /// </summary>
        /// <typeparam name="T">Type des éléments de la séquence.</typeparam>
        /// <param name="source">Séquence à trier.</param>
        /// <param name="selecteurSegment">Fonction qui extrait le libellé du segment de chaque élément.</param>
        /// <returns>Séquence triée selon l'ordre métier de référence.</returns>
        public static IEnumerable<T> TrierParSegment<T>(
            IEnumerable<T> source,
            Func<T, string?> selecteurSegment)
        {
            return source.OrderBy(x => IndexDe(selecteurSegment(x)));
        }
    }
}
