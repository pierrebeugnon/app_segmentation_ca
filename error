@page "/portefeuille"
@inject SegmentationStateService StateService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject RepartitionAutomatiqueService RepartitionService
@inject EtpConversionService EtpService
@inject ReglesHypothesesService ReglesService
@implements IDisposable
@using Segmentation.Client.Components.Dialogs
@using Segmentation.Client.Services
@using Segmentation.Client.Models
@using Segmentation.Client.Components.Dim
@using Segmentation.Shared.Models
@using Segmentation.Shared.Referentiels
@using System.Net.Http.Json
@inject HttpClient Http
@inject DimensionnementPortefeuilleEtpService DimensionnementEtpService

<PageTitle>Dimensionnement Portefeuilles — CA Segmentation</PageTitle>

<div class="ca-page">

    @if (_isLoading)
    {
        <div style="position:fixed;top:0;left:0;width:100%;height:100%;
                    background:rgba(255,255,255,0.7);z-index:9999;
                    display:flex;align-items:center;justify-content:center;
                    flex-direction:column;gap:16px">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.body1" Style="color:#1A4E6B;font-weight:600">
                Chargement en cours...
            </MudText>
        </div>
    }

    <!-- ══════════════════════════════════════════════════════════
         En-tête + toggle ETP / Volume
    ══════════════════════════════════════════════════════════ -->
    <div class="ca-page-header">

        <div>
            <MudText Typo="Typo.h5" Class="ca-page-title">Dimensionnement des Portefeuilles</MudText>
            <MudText Typo="Typo.caption" Class="ca-page-subtitle">
                @(vueEtp
                                ? "Vue ETP — simulation des charges cibles par agence"
                                : "Vue Nombre de clients — projection informative")
            </MudText>
        </div>


        <div style="display:flex;align-items:center;gap:10px">
            @if (vueEtp)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@_isSaving"
                           OnClick="EnregistrerDimensionnementEtp">
                    @(_isSaving ? "Enregistrement..." : "Enregistrer")
                </MudButton>
            }

            <button type="button" class="ca-help-btn" @onclick="ShowAide">
                <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Style="font-size:15px" />
                Aide
            </button>

            <div class="ca-view-toggle">
                <button class="@(vueEtp ? "ca-view-toggle-btn active" : "ca-view-toggle-btn")"
                        @onclick="@(() => vueEtp = true)">
                    <MudIcon Icon="@Icons.Material.Filled.BarChart" Style="font-size:15px" />
                    ETP
                </button>
                <button class="@(!vueEtp ? "ca-view-toggle-btn active" : "ca-view-toggle-btn")"
                        @onclick="@(() => vueEtp = false)">
                    <MudIcon Icon="@Icons.Material.Filled.People" Style="font-size:15px" />
                    Nombre de clients
                </button>
            </div>
        </div>
    </div>

    <!-- ── Filtres organisationnels ────────────────────────────────────── -->
    <DimFiltresBar Region="@filtreRegion"
                   RegionChanged="OnRegionChanged"
                   Secteur="@filtreSecteur"
                   SecteurChanged="OnSecteurChanged"
                   Agence="@filtreAgence"
                   AgenceChanged="OnAgenceChanged"
                   Regions="@allRegions"
                   Secteurs="@allSecteurs"
                   Agences="@allAgences"
                   IsLoading="@_isLoading"
                   HasPendingFilterChanges="@HasPendingFilterChanges"
                   ApplyFilters="ApplyFilters"
                   ClearFilters="ClearFilters" />

    <MudAlert Severity="Severity.Info" Class="mt-2">
        <div><strong>DEBUG :</strong></div>
        <div>SegmentationDistributive : @_segmentationDistributive.Count</div>
        <div>SegmentationDistributiveFiltree : @_segmentationDistributiveFiltree.Count</div>
        <div>Slots : @_slots.Count</div>
        <div>Segments : @segments.Count</div>
        <div>Profils : @profils.Count</div>
        <div>Filtre agence : @(filtreAgence ?? "aucun")</div>
    </MudAlert>

    @if (!segments.Any())
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-2">
            Aucune donnée disponible.
        </MudAlert>
    }
    else
    {
        @if (!_slots.Any())
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2">
                Aucun conseiller avec matricule renseigné pour cette agence. Vous pouvez ajouter des effectifs manuellement ci-dessous.
            </MudAlert>
        }
        <DimTableauEffectifs Slots="_slots"
                               Profils="ProfilsDisponibles"
                               ReadOnly="@(!vueEtp)"
                               OnAddSlot="AddSlot"
                               OnRemoveCibleSlot="RemoveCibleForExistingSlot"
                               OnRestoreCible="RestoreCible"
                               OnRemoveNewSlot="RemoveNewSlot"
                               OnEtpCibleChanged="StateHasChanged" />

        <!-- ══════════════════════════════════════════════════════════
             BLOC 1 — RÉPARTITION DES CHARGES — Existant (▲) + Cible (▼)
             Colonnes = conseillers individuels (slots)
        ══════════════════════════════════════════════════════════ -->
        <MudPaper Elevation="2" Style="border-radius:8px;overflow:hidden">
            <div class="ca-section-header" style="display:flex;align-items:center;gap:10px">
                Répartition des charges par agence @(vueEtp ? "(en ETP)" : "(nombre de clients)") — Existant vs Cible
                <MudTooltip Text="@(vueEtp
                    ? "Chaque cellule affiche : ▲ la valeur existante (lecture seule) et ▼ la cible à saisir. Les colonnes grisées correspondent aux conseillers supprimés du scénario cible."
                    : "Vue de consultation uniquement. Les valeurs sont affichées en nombre de clients.")">
                    <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small"
                             Style="color:rgba(255,255,255,0.65)" />
                </MudTooltip>
                @if (vueEtp)
                {
                    <div style="margin-left:auto">
                        <MudTooltip Text="Distribue automatiquement la charge ETP existante par segment vers les conseillers prioritaires. Remplace toutes les valeurs cibles existantes.">
                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.AutoFixHigh"
                                       Style="color:rgba(255,255,255,0.92);border-color:rgba(255,255,255,0.5);font-size:11px;height:28px;text-transform:none"
                                       OnClick="AutoDistribuerCible">
                                Proposition de répartition de la charge ETP en cible
                            </MudButton>
                        </MudTooltip>
                    </div>
                }
            </div>

            <div class="ca-dim-scroll-wrapper">
                <table class="ca-dim-table">
                    <colgroup>
                        <col style="min-width:160px;width:160px" />
                        @foreach (var profil in profils)
                        {
                            if (_collapsedProfils.Contains(profil))
                            {
                                <col style="min-width:90px;width:90px" />
                            }
                            else
                            {
                                foreach (var _ in SlotsForProfil(profil))
                                {
                                    <col style="min-width:90px;width:90px" />
                                }
                            }
                        }
                        <col style="min-width:68px;width:68px" />
                        <col style="min-width:100px;width:100px" />
                        @if (vueEtp && _showChargesManuelles)
                        {
                            <col style="min-width:110px;width:110px" />
                            <col style="min-width:110px;width:110px" />
                            <col style="min-width:110px;width:110px" />
                        }
                        @if (vueEtp)
                        {
                            <col style="min-width:82px;width:82px" />
                            <col style="min-width:82px;width:82px" />
                        }
                    </colgroup>
                    <thead>
                        <!-- ── Ligne 1 : super-en-tête par métier + toggle Charge ETP ── -->
                        <tr>
                            <th class="ca-dim-sticky-col"
                                style="z-index:200;min-width:160px;text-align:left;padding:5px 12px;font-size:10px;font-weight:600;color:rgba(255,255,255,0.5);letter-spacing:.5px;text-transform:uppercase;background:#0A1F30">
                                Segments distributifs
                            </th>
                            @foreach (var profil in profils)
                            {
                                var p = profil;
                                var isCollapsed = _collapsedProfils.Contains(profil);
                                var slotsGroup = SlotsForProfil(profil).ToList();
                                var span = isCollapsed ? 1 : Math.Max(slotsGroup.Count, 1);
                                <th colspan="@span"
                                    style="text-align:center;padding:5px 6px;font-size:10px;font-weight:700;color:rgba(255,255,255,0.90);
                                           border-left:2px solid rgba(255,255,255,0.15);letter-spacing:.3px;text-transform:uppercase">
                                    <div style="display:flex;align-items:center;justify-content:center;gap:6px">
                                        <span>@profil</span>
                                        <button class="ca-profil-toggle"
                                                @onclick="@(() => ToggleProfil(p))">
                                            <MudIcon Icon="@(isCollapsed? Icons.Material.Filled.Add : Icons.Material.Filled.Remove)"
                                                     Style="font-size:13px;color:white;display:block" />
                                        </button>
                                    </div>
                                    @if (isCollapsed)
                                    {
                                        <div style="font-size:8px;font-weight:400;opacity:0.60;margin-top:2px">@slotsGroup.Count conseiller(s)</div>
                                    }
                                </th>
                            }

                            <!-- Colonne Aide (vide dans la ligne 1) -->
                            <th style="text-align:center;padding:4px 6px;font-size:10px;font-weight:600;color:rgba(255,255,255,0.5);
                                   border-left:2px solid rgba(255,255,255,0.15)">
                            </th>

                            <!-- Groupe "Charge ETP" + toggle +/− (aligné sur le pattern des métiers) -->
                            <th colspan="@(vueEtp && _showChargesManuelles ? 4 : 1)"
                                style="text-align:center;padding:5px 6px;font-size:10px;font-weight:700;color:rgba(255,255,255,0.90);
                                       border-left:2px solid rgba(255,255,255,0.15);letter-spacing:.3px;text-transform:uppercase">
                                <div style="display:flex;align-items:center;justify-content:center;gap:6px">
                                    <span>Charge @(vueEtp ? "ETP" : "clients") par segment</span>
                                    @if (vueEtp)
                                    {
                                        <button class="ca-profil-toggle"
                                                title="@(_showChargesManuelles ? "Masquer les saisies manuelles" : "Afficher les saisies manuelles")"
                                                @onclick="@(() => _showChargesManuelles = !_showChargesManuelles)">
                                            <MudIcon Icon="@(_showChargesManuelles? Icons.Material.Filled.Remove : Icons.Material.Filled.Add)"
                                                     Style="font-size:13px;color:white;display:block" />
                                        </button>
                                    }
                                </div>
                                @if (vueEtp && _showChargesManuelles)
                                {
                                    <div style="font-size:8px;font-weight:400;opacity:0.60;margin-top:2px">4 colonnes</div>
                                }
                            </th>

                            <!-- Colonnes Concordance + Rotation -->
                            @if (vueEtp)
                            {
                                <th colspan="2"
                                    style="text-align:center;padding:5px 6px;font-size:10px;font-weight:700;color:white;letter-spacing:.3px;text-transform:uppercase;
                                                   border-left:2px solid rgba(255,255,255,0.15)">
                                    KPI clé par segment
                                </th>
                            }
                        </tr>

                        <!-- ── Ligne 2 : colonnes individuelles + colonnes KPI ── -->
                        <tr class="ca-dim-superheader">
                            <th class="ca-dim-sticky-col" style="z-index:200;min-width:160px;text-align:left;padding-left:12px;font-size:11px">
                                <button type="button" class="ca-help-btn" @onclick="ShowAideRepartition" style="padding:4px 10px;font-size:10px">
                                    <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Style="font-size:13px" />
                                    Aide
                                </button>
                            </th>
                            @foreach (var profil in profils)
                            {
                                if (_collapsedProfils.Contains(profil))
                                {
                                    <th class="ca-dim-th-profil" style="background:#1C3654;font-style:italic;opacity:0.85">
                                        <div style="font-size:10px;font-weight:600">Σ @profil</div>
                                        <div style="font-size:8px;font-weight:400;opacity:0.7">agrégé</div>
                                    </th>
                                }
                                else
                                {
                                    foreach (var slot in SlotsForProfilDisplay(profil))
                                    {
                                        var isGrey = !slot.IsCible;
                                        var isNew = !slot.IsActuel && slot.IsCible;
                                        <th class="ca-dim-th-profil"
                                            style="@(isGrey ? "background:#D8DEE8;color:#8A9BB0;text-decoration:line-through;opacity:0.65" :
                                                                                         isNew ? "background:#2E8B57;color:white" : "")">
                                            <div style="font-size:11px;font-weight:700">@slot.Profil</div>                                            <div style="font-size:9px;font-weight:400;opacity:0.75">
                                                @slot.Label
                                            </div>
                                        </th>
                                    }
                                }
                            }
                            <th class="ca-dim-th-profil" style="background:#5C7184;color:white">Aide à la répartition des charges cibles par segment</th>
                            <th class="ca-dim-th-profil" style="background:#2D6E86;color:white">
                                @(vueEtp ? "Charge ETP par segment" : "Nombre de clients par segment")
                            </th>
                            @if (vueEtp && _showChargesManuelles)
                            {
                                <th class="ca-dim-th-profil" style="background:#2D6E86;color:white">
                                    Charge à transférer de l'agence vers la Banque Privée
                                </th>
                                <th class="ca-dim-th-profil" style="background:#2D6E86;color:white">
                                    Charge a transférer de la Banque Privée vers l'agence
                                </th>
                                <th class="ca-dim-th-profil" style="background:#2D6E86;color:white">
                                    Charge à transférer vers le portefeuille mutualisé
                                </th>
                            }
                            @if (vueEtp)
                            {
                                <th class="ca-dim-th-profil" style="background:#4A8FA6;color:white">Taux de concordance par segment ("pureté" des portefeuilles)</th>
                                <th class="ca-dim-th-profil" style="background:#4A8FA6;color:white">Taux de rotation des clients par segment</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in filteredRows)
                        {
                            var coverageDiff = vueEtp ? GetCoverageDiff(row) : GetDisplayCoverageDiff(row);
                            var cibleClients = (!vueEtp && !row.IsTotal) ? GetCibleClientsApportionne(row) : null;
                            var concordance = GetConcordance(row);
                            var concordanceExistant = GetConcordanceExistant(row);
                            var rowCible = GetRowCibleTotal(row);
                            var rowExist = GetRowExistantTotal(row);

                            <tr class="@(row.IsTotal ? "ca-dim-tr-total" : "ca-dim-tr-data")" style="@(_estPortefeuilleMutualise && !row.IsTotal && !IsGpStandard(row.Segment) ? "opacity:0.35;background:#F5F5F5" : "")">

                                <!-- Segment label -->
                                <td class="ca-dim-td-segment ca-dim-sticky-col">
                                    @(row.IsTotal
                                                                ? (vueEtp ? "Charge totale ETP par portefeuille" : "Nombre de clients total par portefeuille")
                                                                : row.Segment)
                                </td>

                                <!-- Cellules par métier -->
                                @foreach (var profil in profils)
                                {
                                    if (_collapsedProfils.Contains(profil))
                                    {
                                        var aggExist = GetAggregateExistantForProfil(row, profil);
                                        var aggCib = GetAggregateCibleForProfil(row, profil);
                                        var aggTotal = GetEtpCibleSaisieTotalForProfil(profil);
                                        <td style="text-align:center;padding:6px 4px;background:#EDF4F6">
                                            @if (row.IsTotal)
                                            {
                                                <div style="display:flex;flex-direction:column;align-items:center;gap:1px">
                                                    <span style="font-weight:700;font-size:12px;color:#1A4E6B">
                                                        @FormatTotal(GetDisplayProfilTotal(profil, true))
                                                    </span>
                                                    <div style="border-top:1.5px solid #C5CAD0;width:55%;margin:1px 0"></div>
                                                    <span style="font-size:10px;font-weight:600;font-style:italic;color:#E65100">
                                                        @FormatTotal(GetDisplayProfilTotal(profil, false))
                                                    </span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="ca-dim-cell-inner">
                                                    <div class="ca-dim-cell-top">
                                                        <span style="font-size:11px;font-weight:600;color:#1A4E6B">
                                                            @(!vueEtp ? SlotsForProfil(profil).Where(x => x.IsCible).Sum(x => cibleClients!.GetValueOrDefault(x.Id)).ToString("F0") : FormatDisplay(aggCib, row.Segment))
                                                        </span>
                                                    </div>
                                                    <div class="ca-dim-cell-bottom">
                                                        <span style="color:#E65100;font-size:10px;font-weight:600;font-style:italic">
                                                            @FormatDisplay(aggExist, row.Segment)
                                                        </span>
                                                    </div>
                                                </div>
                                            }
                                        </td>
                                    }
                                    else
                                    {
                                        foreach (var slot in SlotsForProfilDisplay(profil))
                                        {
                                            var s = slot;
                                            var lvl = GetAssignmentLevel(row.Segment, s.Profil);
                                            var etp = row.EtpParProfil.GetValueOrDefault(s.Id);
                                            var cib = row.EtpCibleSaisieParProfil.GetValueOrDefault(s.Id);
                                            var cibNonPrio = !row.IsTotal && lvl == 0 && s.IsCible && cib.HasValue && cib.Value > 0;

                                            <td class="ca-dim-td-merged" style="@GetMergedCellStyle(lvl, row.IsTotal, !s.IsCible);text-align:center;padding:2px">
                                                @if (row.IsTotal)
                                                {
                                                    var totCib = GetDisplayTotalForSlot(s.Id, true);
                                                    var totExist = GetDisplayTotalForSlot(s.Id, false);
                                                    <div style="display:flex;flex-direction:column;align-items:center;padding:4px 2px">
                                                        <span style="font-weight:700;font-size:12px;color:#1A4E6B">
                                                            @FormatTotal(totCib)
                                                        </span>
                                                        <div style="border-top:1.5px solid #C5CAD0;width:60%;margin:2px 0"></div>
                                                        <span style="font-size:10px;font-weight:600;font-style:italic;color:#E65100">
                                                            @FormatTotal(totExist)
                                                        </span>
                                                    </div>
                                                }
                                                else if (vueEtp)
                                                {
                                                    <div class="ca-dim-cell-inner">
                                                        <div class="ca-dim-cell-top">
                                                            @if (s.IsCible)
                                                            {
                                                                <MudNumericField T="double?"
                                                                                 Value="@cib"
                                                                                 ValueChanged="@(v => SetEtpCible(row, s.Id, v))"
                                                                                 Format="F2" Step="0.25" Min="0"
                                                                                 HideSpinButtons="true"
                                                                                 Variant="Variant.Text"
                                                                                 Margin="Margin.Dense"
                                                                                 Class="@($"ca-dim-etp-input{(cibNonPrio ? " ca-etp-nonprio" : "")}")"
                                                                                 InputStyle="@($"text-align:center;font-size:11px;font-weight:700;padding:2px 4px;{(lvl > 0 ? "color:white" : "")}")" />
                                                            }
                                                            else
                                                            {
                                                                <span style="font-size:11px;color:#9AA5B1">—</span>
                                                            }
                                                        </div>
                                                        <div class="ca-dim-cell-bottom">
                                                            <span style="color:#E65100;font-size:10px;font-weight:600;font-style:italic">
                                                                @FormatDisplay(etp, row.Segment)
                                                            </span>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="ca-dim-cell-inner">
                                                        <div class="ca-dim-cell-top">
                                                            <span style="font-size:11px;font-weight:600;@(lvl > 0 ? "color:white" : "color:#1A4E6B")">
                                                                @((s.IsCible && cib.HasValue && cib.Value > 0) ? cibleClients!.GetValueOrDefault(s.Id).ToString("F0") : "—")
                                                            </span>
                                                        </div>
                                                        <div class="ca-dim-cell-bottom">
                                                            <span style="color:#E65100;font-size:10px;font-weight:600;font-style:italic">
                                                                @(GetRealClientCountForSlot(row.Segment, s) is { } realCount ? realCount.ToString("F0") : "—")
                                                            </span>
                                                        </div>
                                                    </div>
                                                }
                                            </td>
                                        }
                                    }
                                }

                                <!-- ── Colonne Aide à la répartition ── -->
                                <td style="text-align:center;padding:4px 3px;background:#F4F5F6">
                                    @if (!row.IsTotal)
                                    {
                                        @if (!coverageDiff.HasValue)
                                        {
                                            <span style="color:#BDBDBD;font-size:11px">—</span>
                                        }
                                        else
                                        {
                                            var diff = coverageDiff.Value;
                                            var absDiff = Math.Abs(diff);
                                            var unit = vueEtp ? "ETP" : "clients";
                                            var (diffFg, diffBg, diffTooltip, diffIcon) = diff switch
                                            {
                                                _ when absDiff < 0.01 =>
                                                ("#2E7D32", "#E8F5E9", "Couverture complète", Icons.Material.Filled.CheckCircle),
                                                _ when diff < 0 =>
                                                ("#C62828", "#FFEBEE", $"Sous-couverture : {Math.Abs(diff):F0} {unit} manquant", Icons.Material.Filled.ArrowDropDown),
                                                _ =>
                                                ("#E65100", "#FFF3E0", $"Sur-répartition : +{diff:F0} {unit} au-delà de la charge", Icons.Material.Filled.ArrowDropUp)
                                            };
                                            <MudTooltip Text="@diffTooltip">
                                                <div style="display:flex;flex-direction:column;align-items:center;gap:0;
                                                                background:@diffBg;border-radius:5px;padding:2px 4px;min-width:48px">
                                                    <MudIcon Icon="@diffIcon" Style="@($"font-size:14px;color:{diffFg};line-height:1")" />
                                                    <span style="font-size:10px;font-weight:700;color:@diffFg;line-height:1.2">
                                                        @(absDiff < 0.01 ? "OK" : (diff > 0 ? "+" : "") + diff.ToString(vueEtp ? "F2" : "F0"))
                                                    </span>
                                                </div>
                                            </MudTooltip>
                                        }
                                    }
                                </td>

                                <!-- ── Colonne 1 : Charge Totale ETP par segment (ajustée) ── -->
                                <td style="text-align:center;padding:6px 4px;background:#EDF4F6">
                                    @if (row.IsTotal)
                                    {
                                        <div style="display:flex;flex-direction:column;align-items:center;gap:1px">
                                            <span style="font-weight:700;font-size:12px;color:#1A4E6B">
                                                @FormatTotal(GetChargeAjusteeTotal())
                                            </span>
                                            <div style="border-top:1.5px solid #C5CAD0;width:55%;margin:1px 0"></div>
                                            <span style="font-size:10px;font-weight:600;font-style:italic;color:#E65100">
                                                @FormatTotal(GetDisplayRowTotal(row, false))
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        @if (!vueEtp)
                                        {
                                            // Vue Clients : base = comptage réel du segment, transferts
                                            // convertis une seule fois (voir GetChargeTotaleClientsAffichee).
                                            // Évite le résidu d'arrondi qui affichait « 1 » sur un segment
                                            // dont toute la charge est sortie.
                                            var clientsAffiches = GetChargeTotaleClientsAffichee(row);
                                            <span style="font-weight:700;font-size:12px;color:#1A4E6B">
                                                @(clientsAffiches.HasValue ? clientsAffiches.Value.ToString("F0") : "—")
                                            </span>
                                        }
                                        else
                                        {
                                            var chargeAffichee = GetChargeTotaleAffichee(row);
                                            <span style="font-weight:700;font-size:12px;color:#1A4E6B">
                                                @FormatDisplay(chargeAffichee, row.Segment)
                                            </span>
                                        }
                                    }
                                </td>

                                <!-- ── Colonne 2 : Charge à transférer à la BP (HDG Premium uniquement) ── -->
                                @if (vueEtp && _showChargesManuelles)
                                {
                                    var bgTransBp = row.IsTotal || IsHdgPremium(row.Segment) ? "#EDF4F6" : "#E4E9ED";
                                    <td style="text-align:center;padding:4px 3px;background:@bgTransBp">
                                        @if (!row.IsTotal)
                                        {
                                            if (_estPortefeuilleMutualise)
                                            {
                                                <span style="color:#BDBDBD;font-size:11px" title="Colonne verrouillée en vue Portefeuille Mutualisé">🔒</span>
                                            }
                                            else if (IsHdgPremium(row.Segment))
                                            {
                                                var segT = row.Segment;
                                                var valTransBP = _chargeATransfererBP.GetValueOrDefault(segT);
                                                var maxTransBP = _estSecteurBanquePrivee ? double.MaxValue : GetChargeExistanteMax(row);
                                                <MudNumericField T="double?"
                                                                 Value="@valTransBP"
                                                                 ValueChanged="@(v => { _chargeATransfererBP[segT] = v.HasValue ? Math.Clamp(v.Value, 0, maxTransBP) : v; StateHasChanged(); })"
                                                                 Format="F2" Step="0.25" Min="0" Max="@maxTransBP"
                                                                 HideSpinButtons="true"
                                                                 Variant="Variant.Text"
                                                                 Margin="Margin.Dense"
                                                                 Class="ca-dim-etp-input"
                                                                 InputStyle="text-align:center;font-size:12px;font-weight:700;padding:2px 4px;color:#1A4E6B" />
                                            }
                                            else
                                            {
                                                <span style="color:#757575;font-size:11px">—</span>
                                            }
                                        }
                                        else
                                        {
                                            var totalTransBP = GetTotalATransfererBP();
                                            <span style="font-weight:700;font-size:12px;color:#1A4E6B">
                                                @(totalTransBP > 0 ? totalTransBP.ToString("F2") : "—")
                                            </span>
                                        }
                                    </td>
                                }

                                <!-- ── Colonne 3 : Charge reçue de la BP (tout sauf HDG Premium) ── -->
                                @if (vueEtp && _showChargesManuelles)
                                {
                                    var bgRecueBp = row.IsTotal || (!IsHdgPremium(row.Segment) && IsSegmentActionnable(row.Segment)) ? "#EDF4F6" : "#E4E9ED";
                                    <td style="text-align:center;padding:4px 3px;background:@bgRecueBp">
                                        @if (!row.IsTotal)
                                        {
                                            if (_estPortefeuilleMutualise)
                                            {
                                                <span style="color:#BDBDBD;font-size:11px" title="Colonne verrouillée en vue Portefeuille Mutualisé">🔒</span>
                                            }
                                            else if (!IsHdgPremium(row.Segment) && IsSegmentActionnable(row.Segment))
                                            {
                                                var segR = row.Segment;
                                                var valRecueBP = _chargeRecueBP.GetValueOrDefault(segR);
                                                var maxRecueBP = _estSecteurBanquePrivee ? GetChargeExistanteMax(row) : double.MaxValue;
                                                <MudNumericField T="double?"
                                                                 Value="@valRecueBP"
                                                                 ValueChanged="@(v => { _chargeRecueBP[segR] = v.HasValue ? Math.Clamp(v.Value, 0, maxRecueBP) : v; StateHasChanged(); })"
                                                                 Format="F2" Step="0.25" Min="0" Max="@maxRecueBP"
                                                                 HideSpinButtons="true"
                                                                 Variant="Variant.Text"
                                                                 Margin="Margin.Dense"
                                                                 Class="ca-dim-etp-input"
                                                                 InputStyle="text-align:center;font-size:12px;font-weight:700;padding:2px 4px;color:#1A4E6B" />
                                            }
                                            else
                                            {
                                                <span style="color:#757575;font-size:11px">—</span>
                                            }
                                        }
                                        else
                                        {
                                            var totalRecueBP = GetTotalRecueBP();
                                            <span style="font-weight:700;font-size:12px;color:#1A4E6B">
                                                @(totalRecueBP > 0 ? totalRecueBP.ToString("F2") : "—")
                                            </span>
                                        }
                                    </td>
                                }

                                <!-- ── Colonne 4 : Charge à transférer en pf mutualisé (GP Standard uniquement) ── -->
                                @if (vueEtp && _showChargesManuelles)
                                {
                                    var bgTransMut = row.IsTotal || IsGpStandard(row.Segment) ? "#EDF4F6" : "#E4E9ED";
                                    <td style="text-align:center;padding:4px 3px;background:@bgTransMut">
                                        @if (!row.IsTotal)
                                        {
                                            if (IsGpStandard(row.Segment))
                                            {
                                                var segM = row.Segment;
                                                var valTransMut = _chargeATransfererMutualise.GetValueOrDefault(segM);
                                                // Cette colonne reste éditable même en vue Portefeuille Mutualisé
                                                // (seules les 2 colonnes Agence↔BP sont verrouillées dans cette vue).
                                                var maxTransMut = _estPortefeuilleMutualise ? double.MaxValue : GetChargeExistanteMax(row);
                                                <MudNumericField T="double?"
                                                                 Value="@valTransMut"
                                                                 ValueChanged="@(v => { _chargeATransfererMutualise[segM] = v.HasValue ? Math.Clamp(v.Value, 0, maxTransMut) : v; StateHasChanged(); })"
                                                                 Format="F2" Step="0.25" Min="0" Max="@maxTransMut"
                                                                 HideSpinButtons="true"
                                                                 Variant="Variant.Text"
                                                                 Margin="Margin.Dense"
                                                                 Class="ca-dim-etp-input"
                                                                 InputStyle="text-align:center;font-size:12px;font-weight:700;padding:2px 4px;color:#1A4E6B" />
                                            }
                                            else
                                            {
                                                <span style="color:#757575;font-size:11px">—</span>
                                            }
                                        }
                                        else
                                        {
                                            var totalTransMut = GetTotalATransfererMutualise();
                                            <span style="font-weight:700;font-size:12px;color:#1A4E6B">
                                                @(totalTransMut > 0 ? totalTransMut.ToString("F2") : "—")
                                            </span>
                                        }
                                    </td>
                                }

                                <!-- ── Colonne Concordance ── -->
                                @if (vueEtp)
                                {
                                    <!-- ── Colonne Concordance ── -->
                                    <td style="text-align:center;padding:4px 3px;background:#EDF4F6">
                                        @if (row.IsTotal)
                                        {
                                            var totalConcCib = GetTotalConcordance();
                                            var totalConcExi = GetTotalConcordanceExistant();
                                            var (bgCib, fgCib) = GetConcordanceColors(totalConcCib);
                                            var (bgExi, fgExi) = GetConcordanceColors(totalConcExi);
                                            <div style="display:flex;flex-direction:column;align-items:center;gap:1px">
                                                <div style="background:@bgCib;border-radius:5px;padding:2px 6px;min-width:48px">
                                                    <span style="font-size:12px;font-weight:700;color:@fgCib">
                                                        @(totalConcCib.HasValue ? $"{totalConcCib.Value:F0}%" : "—")
                                                    </span>
                                                </div>
                                                <div style="border-top:1.5px solid #C5CAD0;width:55%;margin:1px 0"></div>
                                                <div style="background:@bgExi;border-radius:5px;padding:2px 6px;min-width:48px">
                                                    <span style="font-size:9px;font-weight:700;color:@fgExi">
                                                        @(totalConcExi.HasValue ? $"{totalConcExi.Value:F0}%" : "—")
                                                    </span>
                                                </div>
                                            </div>
                                        }
                                        else if (concordance.pct.HasValue || concordanceExistant.pct.HasValue)
                                        {
                                            var (bgCib, fgCib) = GetConcordanceColors(concordance.pct);
                                            var (bgExi, fgExi) = GetConcordanceColors(concordanceExistant.pct);
                                            <div style="display:flex;flex-direction:column;align-items:center;gap:1px">
                                                <div style="background:@bgCib;border-radius:5px;padding:2px 6px;min-width:48px">
                                                    <span style="font-size:12px;font-weight:700;color:@fgCib">
                                                        @(concordance.pct.HasValue ? $"{concordance.pct.Value:F0}%" : "—")
                                                    </span>
                                                </div>
                                                <div style="border-top:1.5px solid #C5CAD0;width:55%;margin:1px 0"></div>
                                                <div style="background:@bgExi;border-radius:5px;padding:2px 6px;min-width:48px">
                                                    <span style="font-size:9px;font-weight:700;color:@fgExi">
                                                        @(concordanceExistant.pct.HasValue ? $"{concordanceExistant.pct.Value:F0}%" : "—")
                                                    </span>
                                                </div>
                                            </div>
                                        }
                                    else
                                    {
                                        <span style="color:#BDBDBD;font-size:11px">—</span>
                                    }
                                </td>

                                    <!-- ── Colonne Taux de rotation par segment ── -->
                                    <td style="text-align:center;padding:4px 3px;background:#EDF4F6">
                                        @{
                                            var rotRow = GetTauxRotationForRow(row);
                                        }
                                        @if (row.IsTotal)
                                        {
                                            var rotTotalCib = GetTotalTauxRotation();
                                            var rotColorTotalCib = RotationColor(rotTotalCib);
                                            <span style="font-size:12px;font-weight:700;color:@rotColorTotalCib">
                                                @(rotTotalCib.HasValue? rotTotalCib.Value.ToString("F0") + "%" : "—")
                                            </span>
                                        }
                                        else if (rotRow.HasValue)
                                        {
                                            var rotColorCib = RotationColor(rotRow);
                                            <span style="font-size:12px;font-weight:700;color:@rotColorCib">
                                                @(rotRow.HasValue? rotRow.Value.ToString("F0") + "%" : "—")
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color:#BDBDBD;font-size:11px">—</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>

                    @if (vueEtp)
                    {
                    <!-- ═══════════════════════════════════════════════════════
                         TBODY KPI — colonnes conditionnelles selon _showChargesManuelles
                    ═══════════════════════════════════════════════════════ -->
                    <tbody>
                        <!-- Séparateur -->
                        @{
                            var extraCols = (vueEtp && _showChargesManuelles) ? 7 : 4;
                        }
                        <tr style="background:#0A1F30">
                            <td style="padding:3px 12px;font-size:9px;font-weight:700;color:rgba(255,255,255,0.75);letter-spacing:1px;text-transform:uppercase">
                                Indicateurs KPI
                            </td>
                            @for (int _i = 0; _i < VisibleSlotColumnCount + extraCols; _i++)
                            {
                                <td style="background:#0A1F30"></td>
                            }
                        </tr>

                        <!-- ── Evolution des effectifs ── -->
                        @{
                            var kpiEvoTotal = (double)_slots.Sum(s => GetEvolutionForSlot(s));
                        }
                        <tr style="background:#1C3D62">
                            <td class="ca-dim-sticky-col" style="background:#1C3D62;padding:6px 10px;font-size:10px;font-weight:600;color:white;white-space:normal;line-height:1.3">
                                Evolution des effectifs (cible vs existant)
                            </td>
                            @foreach (var profil in profils)
                            {
                                if (_collapsedProfils.Contains(profil))
                                {
                                    var evo = GetEvolutionForProfil(profil);
                                    <td style="text-align:center;padding:6px 3px;font-size:11px;font-style:italic;@DiffColor(evo, positifBon: true)">@FormatDiff(evo)</td>
                                }
                                else
                                {
                                    foreach (var slot in SlotsForProfilDisplay(profil))
                                    {
                                        var evo = GetEvolutionForSlot(slot);
                                        <td style="text-align:center;padding:6px 3px;font-size:11px;@DiffColor(evo, positifBon: true);@(!slot.IsCible ? "opacity:0.35" : "")">@FormatDiff(evo)</td>
                                    }
                                }
                            }
                            <td style="background:#1C3D62"></td>
                            <td style="text-align:center;padding:6px 4px;font-size:11px;font-weight:700;background:#182F4A;@DiffColor(kpiEvoTotal, positifBon: true)">@FormatDiff(kpiEvoTotal)</td>
                            @if (vueEtp && _showChargesManuelles)
                            {
                                <td style="background:#1C3D62"></td>
                                <td style="background:#1C3D62"></td>
                                <td style="background:#1C3D62"></td>
                            }
                            <td style="background:#1C3D62"></td>
                            <td style="background:#1C3D62"></td>
                        </tr>

                        <!-- ── Remplissage des portefeuilles ── -->
                        @{
                            var kpiRmpCibTotal = GetRemplissageTotal();
                            var kpiRmpExiTotal = GetRemplissageExistantTotal();
                        }
                        <tr style="background:#1A3558">
                            <td class="ca-dim-sticky-col" style="background:#1A3558;padding:6px 10px;font-size:10px;font-weight:600;color:white;white-space:normal;line-height:1.3">
                                Taux de remplissage des portefeuilles
                                <div style="font-size:9px;font-weight:400;opacity:0.65;margin-top:1px">▼ Cible &nbsp;/&nbsp; ▲ Existant</div>
                            </td>
                            @foreach (var profil in profils)
                            {
                                if (_collapsedProfils.Contains(profil))
                                {
                                    var rmpCib = GetRemplissageForProfil(profil);
                                    var rmpExi = GetRemplissageExistantForProfil(profil);
                                    <td style="text-align:center;padding:3px;font-style:italic">
                                        <div style="font-size:11px;color:white">@(rmpCib.HasValue ? $"{rmpCib.Value:F0}%" : "—")</div>
                                        <div style="border-top:1px solid rgba(255,255,255,0.3);width:50%;margin:1px auto"></div>
                                        <div style="font-size:9px;font-weight:700;color:#E65100">@(rmpExi.HasValue ? $"{rmpExi.Value:F0}%" : "—")</div>
                                    </td>
                                }
                                else
                                {
                                    foreach (var slot in SlotsForProfilDisplay(profil))
                                    {
                                        var rmpCib = GetRemplissageForSlot(slot);
                                        var rmpExi = GetRemplissageExistantForSlot(slot);
                                        <td style="text-align:center;padding:3px;@(!slot.IsCible ? "opacity:0.35" : "")">
                                            <div style="font-size:11px;color:white">@(rmpCib.HasValue ? $"{rmpCib.Value:F0}%" : "—")</div>
                                            <div style="border-top:1px solid rgba(255,255,255,0.3);width:50%;margin:1px auto"></div>
                                            <div style="font-size:9px;font-weight:700;color:#E65100">@(rmpExi.HasValue ? $"{rmpExi.Value:F0}%" : "—")</div>
                                        </td>
                                    }
                                }
                            }
                            <td style="background:#1A3558"></td>
                            <td style="text-align:center;padding:3px;background:#162840">
                                <div style="font-size:12px;color:white">@(kpiRmpCibTotal.HasValue ? $"{kpiRmpCibTotal.Value:F0}%" : "—")</div>
                                <div style="border-top:1px solid rgba(255,255,255,0.3);width:50%;margin:1px auto"></div>
                                <div style="font-size:9px;font-weight:700;color:#E65100">@(kpiRmpExiTotal.HasValue ? $"{kpiRmpExiTotal.Value:F0}%" : "—")</div>
                            </td>
                            @if (vueEtp && _showChargesManuelles)
                            {
                                <td style="background:#1A3558"></td>
                                <td style="background:#1A3558"></td>
                                <td style="background:#1A3558"></td>
                            }
                            <td style="background:#1A3558"></td>
                            <td style="background:#1A3558"></td>
                        </tr>

                        <!-- ── Concordance ── -->
                        @{
                            var allCibleConc = _slots.Where(s => s.IsCible).Sum(s => GetEtpCibleSaisieTotal(s.Id) ?? 0);
                            var allDesigneConc = _slots.Where(s => s.IsCible)
                            .Sum(s => rows.Where(r => !r.IsTotal && GetAssignmentLevel(r.Segment, s.Profil) > 0)
                            .Sum(r => r.EtpCibleSaisieParProfil.GetValueOrDefault(s.Id) ?? 0));
                            double? kpiConcCibTotal = allCibleConc > 0 ? allDesigneConc / allCibleConc * 100.0 : null;

                            var allExistConc = _slots.Sum(s => GetTotalEtpExistantForSlot(s.Id) ?? 0);
                            var allDesigneExistConc = _slots
                            .Sum(s => rows.Where(r => !r.IsTotal && GetAssignmentLevel(r.Segment, s.Profil) > 0)
                            .Sum(r => r.EtpParProfil.GetValueOrDefault(s.Id) ?? 0));
                            double? kpiConcExiTotal = allExistConc > 0 ? allDesigneExistConc / allExistConc * 100.0 : null;
                        }
                        <tr style="background:#1F446A">
                            <td class="ca-dim-sticky-col" style="background:#1F446A;padding:6px 10px;font-size:10px;font-weight:600;color:white;white-space:normal;line-height:1.3">
                                Taux de concordance par conseiller ("pureté" des portefeuilles)
                                <div style="font-size:9px;font-weight:400;opacity:0.65;margin-top:1px">▼ Cible &nbsp;/&nbsp; ▲ Existant</div>
                            </td>
                            @foreach (var profil in profils)
                            {
                                if (_collapsedProfils.Contains(profil))
                                {
                                    var (concPctCib, concColorCib) = GetConcordanceForProfil(profil);
                                    var (concPctExi, concColorExi) = GetConcordanceExistantForProfil(profil);
                                    <td style="text-align:center;padding:3px;font-style:italic">
                                        <div style="font-size:11px;color:white">@(concPctCib.HasValue ? $"{concPctCib.Value:F0}%" : "—")</div>
                                        <div style="border-top:1px solid rgba(255,255,255,0.3);width:50%;margin:1px auto"></div>
                                        <div style="font-size:9px;font-weight:700;color:#E65100">@(concPctExi.HasValue ? $"{concPctExi.Value:F0}%" : "—")</div>
                                    </td>
                                }
                                else
                                {
                                    foreach (var slot in SlotsForProfilDisplay(profil))
                                    {
                                        var (concPctCib, concColorCib) = GetConcordanceForSlot(slot);
                                        var (concPctExi, concColorExi) = GetConcordanceExistantForSlot(slot);
                                        <td style="text-align:center;padding:3px;@(!slot.IsCible ? "opacity:0.35" : "")">
                                            <div style="font-size:11px;color:white">@(concPctCib.HasValue ? $"{concPctCib.Value:F0}%" : "—")</div>
                                            <div style="border-top:1px solid rgba(255,255,255,0.3);width:50%;margin:1px auto"></div>
                                            <div style="font-size:9px;font-weight:700;color:#E65100">@(concPctExi.HasValue ? $"{concPctExi.Value:F0}%" : "—")</div>
                                        </td>
                                    }
                                }
                            }
                            <td style="background:#1F446A"></td>
                            <td style="text-align:center;padding:3px;background:#193252">
                                <div style="font-size:12px;color:white">@(kpiConcCibTotal.HasValue ? $"{kpiConcCibTotal.Value:F0}%" : "—")</div>
                                <div style="border-top:1px solid rgba(255,255,255,0.3);width:50%;margin:1px auto"></div>
                                <div style="font-size:9px;@ConcordanceColor(kpiConcExiTotal)">@(kpiConcExiTotal.HasValue ? $"{kpiConcExiTotal.Value:F0}%" : "—")</div>
                            </td>
                            @if (vueEtp && _showChargesManuelles)
                            {
                                <td style="background:#1F446A"></td>
                                <td style="background:#1F446A"></td>
                                <td style="background:#1F446A"></td>
                            }
                            <td style="background:#1F446A"></td>
                            <td style="background:#1F446A"></td>
                        </tr>

                        <!-- ── Taux de rotation ── -->
                        @{
                                var rotAllCible = Math.Round(_slots.Where(s => s.IsCible).Sum(s => GetEtpCibleSaisieTotal(s.Id) ?? 0), 2);
                                var activeSlotsRot = _slots.Where(s => s.IsCible).ToList();
                                var rotAllGains = rows.Where(r => !r.IsTotal).Sum(r => activeSlotsRot.Sum(s => GetEntreesCell(r, s.Id)));
                                double? kpiRotTotal = rotAllCible > 0 ? Math.Round(rotAllGains, 2) / rotAllCible * 100.0 : null;
                        }
                        <tr style="background:#224A72">
                            <td class="ca-dim-sticky-col" style="background:#224A72;padding:6px 10px;font-size:10px;font-weight:600;color:white;white-space:normal;line-height:1.3">
                                Taux de rotation des clients par portefeuille (entrée et sortie)
                            </td>
                            @foreach (var profil in profils)
                            {
                                if (_collapsedProfils.Contains(profil))
                                {
                                    var rot = GetTauxRotationForProfil(profil);
                                    <td style="text-align:center;padding:6px 3px;font-size:11px;font-style:italic;color:white">
                                        @(rot.HasValue ? $"{rot.Value:+0.0;-0.0;0.0}%" : "—")
                                    </td>
                                }
                                else
                                {
                                    foreach (var slot in SlotsForProfilDisplay(profil))
                                    {
                                        var rot = GetTauxRotation(slot);
                                        <td style="text-align:center;padding:6px 3px;font-size:11px;color:white;@(!slot.IsCible ? "opacity:0.35" : "")">
                                            @(rot.HasValue ? $"{rot.Value:+0.0;-0.0;0.0}%" : "—")
                                        </td>
                                    }
                                }
                            }
                            <td style="background:#224A72"></td>
                            <td style="text-align:center;padding:6px 4px;font-size:12px;font-weight:700;background:#1B3959;color:white">
                                @(kpiRotTotal.HasValue ? $"{kpiRotTotal.Value:+0.0;-0.0;0.0}%" : "—")
                            </td>
                            @if (vueEtp && _showChargesManuelles)
                            {
                                <td style="background:#224A72"></td>
                                <td style="background:#224A72"></td>
                                <td style="background:#224A72"></td>
                            }
                            <td style="background:#224A72"></td>
                            <td style="background:#224A72"></td>
                        </tr>

                        <!-- ── Taux d'entrée ── -->
                        @{
                            var entDiff = vueEtp ? GetTauxEntreeTotal() : GetDisplayTauxEntreeTotal();
                            double? kpiEntTotal = entDiff > 0 ? entDiff : null;
                        }
                        <tr style="background:#24507A">
                            <td class="ca-dim-sticky-col" style="background:#24507A;padding:6px 10px;font-size:10px;font-weight:600;color:white;white-space:normal;line-height:1.3">
                                Part de nouveaux clients dans le portefeuille cible (vs existant)
                            </td>
                                @foreach (var profil in profils)
                                {
                                    if (_collapsedProfils.Contains(profil))
                                    {
                                        var ent = vueEtp ? GetTauxEntreeForProfil(profil) : GetDisplayTauxEntreeForProfil(profil);
                                        <td style="text-align:center;padding:6px 3px;font-size:11px;font-style:italic;color:white">
                                            @(ent.HasValue? ent.Value.ToString("F0") + "%" : "—")
                                        </td>
                                    }
                                    else
                                    {
                                        foreach (var slot in SlotsForProfilDisplay(profil))
                                        {
                                            var ent = vueEtp ? GetTauxEntreeSlot(slot) : GetDisplayTauxEntreeSlot(slot);
                                            <td style="text-align:center;padding:6px 3px;font-size:11px;color:white;@(!slot.IsCible ? "opacity:0.35" : "")">
                                                @(ent.HasValue? ent.Value.ToString("F0") + "%" : "—")
                                            </td>
                                        }
                                    }
                                }
                                <td style="background:#24507A"></td>
                                <td style="text-align:center;padding:6px 4px;font-size:12px;font-weight:700;color:white;background:#1C3C5E">
                                    @(kpiEntTotal.HasValue? kpiEntTotal.Value.ToString("F0") + "%" : "—")
                                </td>
                            @if (vueEtp && _showChargesManuelles)
                            {
                                <td style="background:#24507A"></td>
                                <td style="background:#24507A"></td>
                                <td style="background:#24507A"></td>
                            }
                            <td style="background:#24507A"></td>
                            <td style="background:#24507A"></td>
                        </tr>
                    </tbody>
                    }
                </table>
            </div>
        </MudPaper>
    }

    <div class="ca-footer">© 2026 Crédit Agricole Nord de France — Plateforme de simulation de dimensionnement des portefeuilles</div>
</div>
