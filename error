public DashboardKpis ComputeGlobalKpis(
			List<SegmentationDistributiveData> data,
			ReglesHypothesesModel? regles,
			List<DimensionnementPortefeuilleEtpAllLigne>? lignesEtp = null)
		{
			if (data == null || !data.Any())
				return new DashboardKpis();

			// 1. Conseillers existants (matricules distincts en poste) —
			//    affiché sur la carte "Nombre de conseillers" uniquement,
			//    n'entre plus dans aucun autre KPI ci-dessous.
			var conseillersExistants = data
				.Where(x => !string.IsNullOrWhiteSpace(x.MatriculeConseiller))
				.Select(x => x.MatriculeConseiller)
				.Distinct(StringComparer.OrdinalIgnoreCase)
				.Count();

			// 2. Clients commerciaux (somme de tous les segments)
			var clientsCommerciaux =
				data.Sum(x => x.HDGPremiumPotentiel + x.HDGPremiumStandard
							+ x.HDGPotentiel + x.HDGSeniorEpargnant + x.HDGStandard
							+ x.CIPotentiel + x.CIStandard
							+ x.GPPotentiel + x.GPStandard
							+ x.NonSegmente + x.NonClasse);

			// 3. ETP nécessaires (charge théorique par segment) — sert de
			//    référence pour la cible théorique et l'écart effectif/charge.
			var etpNecessaires = ComputeTotalEtpBesoin(data, regles);
			var conseillersCiblesTheorique = (int)Math.Round(etpNecessaires);

			// 4. Lignes ETP réellement sauvegardées pour le périmètre
			//    (DimensionnementPortefeuilleEtp), utilisées par tous les
			//    KPIs "cible" ci-dessous.
			var agencesDuPerimetre = data
				.Select(x => x.LibAgence)
				.Where(a => !string.IsNullOrWhiteSpace(a))
				.Distinct(StringComparer.OrdinalIgnoreCase)
				.ToHashSet(StringComparer.OrdinalIgnoreCase);

			var lignesPerimetre = (lignesEtp ?? new())
				.Where(l => agencesDuPerimetre.Contains(l.LibAgence))
				.ToList();

			var lignesCible = lignesPerimetre.Where(l => l.IsCible).ToList();

			// Effectif cible réellement sauvegardé (IsCible=1), distinct par
			// conseiller (matricule, ou label en clé de secours pour un ajout
			// manuel sans matricule).
			var effectifCibleReel = lignesCible
				.Select(CleConseillerEtp)
				.Distinct(StringComparer.OrdinalIgnoreCase)
				.Count();

			// 5. Taux de remplissage = cible réelle sauvegardée ÷ cible
			//    théorique — ne se base plus sur l'existant.
			var tauxCouverture = conseillersCiblesTheorique > 0
				? (double)effectifCibleReel / conseillersCiblesTheorique * 100.0
				: 0;

			// 6. Concordance = part de l'ETP CIBLE (pas existant) attribuée
			//    au conseiller prioritaire désigné en R&H pour le segment.
			var etpCibleTotal = lignesCible.Sum(l => l.EtpCible ?? 0);
			var etpCibleConcordant = lignesCible
				.Where(l => EstProfilPrioritaire(l.Segment, l.ProfilConseiller, regles))
				.Sum(l => l.EtpCible ?? 0);
			var concordance = etpCibleTotal > 0
				? etpCibleConcordant / etpCibleTotal * 100.0
				: 0;

			// 7. Taux de pureté des portefeuilles (reste basé sur la
			//    segmentation réelle du réseau — inchangé)
			var tauxPurete = ComputeTauxPurete(data, regles);

			// 8. Écart Effectif cible réel − Charge ETP théorique.
			var ecartEffectifChargeEtp = effectifCibleReel - etpNecessaires;

			// 9. Taux de rotation (Option A) = somme des gains uniquement
			//    (cible > existant, mouvement individuel par conseiller),
			//    rapportée à la charge CIBLE réellement sauvegardée — pas à
			//    la charge théorique — pour rester basé sur la cible.
			var gainsRotation = lignesPerimetre.Sum(l =>
				Math.Max(0, (l.EtpCible ?? 0) - (l.EtpExistant ?? 0)));

			var tauxRotationEntrees = etpCibleTotal > 0
				? gainsRotation / etpCibleTotal * 100.0
				: 0;

			return new DashboardKpis
			{
				ConseillersExistants = conseillersExistants,
				ConseillersCibles = effectifCibleReel,
				ClientsCommerciaux = clientsCommerciaux,
				EtpNecessaires = Math.Round(etpNecessaires, 1),
				TauxCouverture = Math.Round(tauxCouverture, 0),
				Concordance = Math.Round(concordance, 0),
				EcartEffectifChargeEtp = Math.Round(ecartEffectifChargeEtp, 1),
				TauxRotationEntrees = Math.Round(tauxRotationEntrees, 0),
				TauxPurete = Math.Round(tauxPurete, 0)
			};
		}

		/// <summary>
		/// Vrai si ce profil est le conseiller prioritaire désigné dans les
		/// Règles &amp; Hypothèses pour ce segment.
		/// </summary>
		private static bool EstProfilPrioritaire(
			string segment,
			string profil,
			ReglesHypothesesModel? regles)
		{
			if (regles == null || string.IsNullOrWhiteSpace(segment) || string.IsNullOrWhiteSpace(profil))
				return false;

			var regle = regles.ReglesAffectationSegments
				.FirstOrDefault(r => string.Equals(
					r.Segment?.Trim(), segment.Trim(), StringComparison.OrdinalIgnoreCase));

			return regle?.ConseillerPrioritaire?.Trim()
				.Equals(profil.Trim(), StringComparison.OrdinalIgnoreCase) == true;
		}
