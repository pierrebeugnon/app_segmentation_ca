private bool _estPortefeuilleMutualise = false;

_estSecteurBanquePrivee = filtreSecteur?.Contains("Banque", StringComparison.OrdinalIgnoreCase) == true;

if (string.IsNullOrEmpty(filtreAgence) && allAgences.Any() && !_estSecteurBanquePrivee)
{
    filtreAgence = allAgences.First();
}

_estPortefeuilleMutualise = filtreAgence?.Contains("Portefeuille mutualisé", StringComparison.OrdinalIgnoreCase) == true;




private double? GetChargeTotaleAffichee(DimMatrixRow row)
{
    if (row.IsTotal) return null;

    var original = GetRowExistantTotal(row) ?? 0;
    var transBP = _chargeATransfererBP.GetValueOrDefault(row.Segment) ?? 0;
    var recueBP = _chargeRecueBP.GetValueOrDefault(row.Segment) ?? 0;
    var transMut = _chargeATransfererMutualise.GetValueOrDefault(row.Segment) ?? 0;

    // Le sens des 3 transferts change selon le point de vue :
    // - Agence  : Agence→BP soustrait, BP→Agence ajouté, vers Mutualisé soustrait
    // - Banque Privée : Agence→BP ajouté, BP→Agence soustrait, vers Mutualisé soustrait
    // - Portefeuille Mutualisé : Agence→BP soustrait, BP→Agence soustrait, vers Mutualisé ajouté
    if (_estPortefeuilleMutualise)
        return (original - transBP - recueBP) + transMut;

    if (_estSecteurBanquePrivee)
        return (original + transBP - recueBP) - transMut;

    return (original - transBP + recueBP) - transMut;
}

