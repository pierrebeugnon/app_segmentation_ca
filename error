@namespace Segmentation.Client.Components.Dashboard

<MudPaper Elevation="1" Style="border-radius:12px;overflow:hidden;margin-top:20px;border:1px solid #E8ECF1">
    <div style="padding:16px 20px 4px 20px;display:flex;align-items:center;gap:8px">
        <MudIcon Icon="@Icons.Material.Filled.SyncAlt" Style="font-size:19px;color:#1A4E6B" />
        <span style="font-size:15px;font-weight:700;color:#1A4E6B">Suivi des transferts entre Agences, Banque Privée et Portefeuilles Mutualisés</span>
        <MudTooltip Text="Un badge rouge signale un écart entre ce qui est déclaré d'un côté et confirmé de l'autre — transfert potentiellement en attente.">
            <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Style="color:#9AA5B1" />
        </MudTooltip>
    </div>

    <div style="padding:4px 20px 16px 20px;font-size:12px;color:#6C7A89">
        Comparaison des montants déclarés d'un côté et réceptionnés de l'autre, par segment
    </div>

    <div style="overflow-x:auto;padding:0 12px 16px 12px">
        <table style="width:100%;border-collapse:collapse;font-size:12.5px">
            <thead>
                <tr>
                    <th rowspan="2" style="text-align:left;padding:8px 12px;min-width:160px;background:#F5F7FA;color:#5C6B7A;font-size:10px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;border-bottom:2px solid #E1E6EC">
                        Segments distributifs
                    </th>
                    <th colspan="2" style="text-align:center;padding:6px;background:#F5F7FA;color:#1A6B3C;font-size:10.5px;font-weight:700;letter-spacing:.3px;text-transform:uppercase;border-bottom:2px solid #E1E6EC;border-left:1px solid #E1E6EC">
                        Vers la Banque Privée
                    </th>
                    <th colspan="2" style="text-align:center;padding:6px;background:#F5F7FA;color:#1A4E6B;font-size:10.5px;font-weight:700;letter-spacing:.3px;text-transform:uppercase;border-bottom:2px solid #E1E6EC;border-left:1px solid #E1E6EC">
                        Vers les Agences
                    </th>
                    <th colspan="2" style="text-align:center;padding:6px;background:#F5F7FA;color:#6A4C93;font-size:10.5px;font-weight:700;letter-spacing:.3px;text-transform:uppercase;border-bottom:2px solid #E1E6EC;border-left:1px solid #E1E6EC">
                        Vers le Portefeuille Mutualisé
                    </th>
                </tr>
                <tr>
                    <th style="text-align:center;padding:6px;background:#FAFBFC;color:#8A96A3;font-size:9.5px;font-weight:600;border-bottom:1px solid #E1E6EC;border-left:1px solid #E1E6EC">Charge sortie de l'agence</th>
                    <th style="text-align:center;padding:6px;background:#FAFBFC;color:#8A96A3;font-size:9.5px;font-weight:600;border-bottom:1px solid #E1E6EC">Charge reçue en BP</th>
                    <th style="text-align:center;padding:6px;background:#FAFBFC;color:#8A96A3;font-size:9.5px;font-weight:600;border-bottom:1px solid #E1E6EC;border-left:1px solid #E1E6EC">Charge reçue en Agence</th>
                    <th style="text-align:center;padding:6px;background:#FAFBFC;color:#8A96A3;font-size:9.5px;font-weight:600;border-bottom:1px solid #E1E6EC">Charge sortie de la BP</th>
                    <th style="text-align:center;padding:6px;background:#FAFBFC;color:#8A96A3;font-size:9.5px;font-weight:600;border-bottom:1px solid #E1E6EC;border-left:1px solid #E1E6EC">Charge sortie de l'agence ou la BP</th>
                    <th style="text-align:center;padding:6px;background:#FAFBFC;color:#8A96A3;font-size:9.5px;font-weight:600;border-bottom:1px solid #E1E6EC">Charge reçue Portefeuille Mutualisé</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var seg in Segments)
                {
                    var ligne = GetLigne(seg);
                    <tr style="border-bottom:1px solid #F0F2F5">
                        <td style="padding:7px 12px;font-style:italic;color:#4A5A6E;font-size:12px">@seg</td>
                        @RenderCell(ligne.DeclareBP, ligne.ReceptionneBP, IsHdgPremium(seg), true)
                        @RenderCell(ligne.DeclareAgence, ligne.ReceptionneAgence, IsSegmentActionnable(seg) && !IsHdgPremium(seg), false)
                        @RenderCell(ligne.DeclareMutualise, ligne.PlaceMutualise, IsGpStandard(seg), false)
                    </tr>
                }
                <tr style="background:#F5F7FA;font-weight:700">
                    <td style="padding:8px 12px;color:#1A4E6B;font-size:12px">TOTAL</td>
                    @{
                        var totalLigne = GetTotal();
                    }
                    @RenderCell(totalLigne.DeclareBP, totalLigne.ReceptionneBP, true, true)
                    @RenderCell(totalLigne.DeclareAgence, totalLigne.ReceptionneAgence, true, false)
                    @RenderCell(totalLigne.DeclareMutualise, totalLigne.PlaceMutualise, true, false)
                </tr>
            </tbody>
        </table>
    </div>
</MudPaper>

@code {
    [Parameter] public List<DimensionnementPortefeuilleEtpAllCharge> Charges { get; set; } = new();
    [Parameter] public string? FiltreRegion { get; set; }
    [Parameter] public string? FiltreSecteur { get; set; }
    [Parameter] public string? FiltreAgence { get; set; }

    private static readonly List<string> Segments = new()
    {
        "HDG Premium Potentiel", "HDG Premium Standard", "HDG Potentiel",
        "HDG Senior Epargnant", "HDG Standard", "CI Potentiel",
        "CI Standard", "GP Potentiel", "GP Standard"
    };

    private static bool IsHdgPremium(string segment) => segment.Contains("Premium", StringComparison.OrdinalIgnoreCase);
    private static bool IsGpStandard(string segment) => segment.Equals("GP Standard", StringComparison.OrdinalIgnoreCase);
    private static bool IsSegmentActionnable(string segment) =>
        !segment.Equals("Non segmenté", StringComparison.OrdinalIgnoreCase) &&
        !segment.Equals("Non classé", StringComparison.OrdinalIgnoreCase);

    private List<DimensionnementPortefeuilleEtpAllCharge> FiltreesParPerimetre() =>
        Charges
            .Where(c => string.IsNullOrEmpty(FiltreRegion) || c.LibRegion == FiltreRegion)
            .Where(c => string.IsNullOrEmpty(FiltreSecteur) || c.LibSecteur == FiltreSecteur)
            .Where(c => string.IsNullOrEmpty(FiltreAgence) || c.LibAgence == FiltreAgence)
            .ToList();

    private static bool EstBanquePrivee(DimensionnementPortefeuilleEtpAllCharge c) =>
        c.LibSecteur?.Contains("Banque", StringComparison.OrdinalIgnoreCase) == true;

    private static bool EstMutualise(DimensionnementPortefeuilleEtpAllCharge c) =>
        c.LibAgence?.Contains("Portefeuille mutualisé", StringComparison.OrdinalIgnoreCase) == true;

    private (double DeclareBP, double ReceptionneBP, double DeclareAgence, double ReceptionneAgence, double DeclareMutualise, double PlaceMutualise) GetLigne(string segment)
    {
        var data = FiltreesParPerimetre().Where(c => c.Segment.Equals(segment, StringComparison.OrdinalIgnoreCase)).ToList();

        var declareBP = data.Where(c => !EstBanquePrivee(c) && !EstMutualise(c)).Sum(c => c.ChargeATransfererBP ?? 0);
        var receptionneBP = data.Where(c => EstBanquePrivee(c)).Sum(c => c.ChargeATransfererBP ?? 0);

        var declareAgence = data.Where(c => !EstBanquePrivee(c) && !EstMutualise(c)).Sum(c => c.ChargeRecueBP ?? 0);
        var receptionneAgence = data.Where(c => EstBanquePrivee(c)).Sum(c => c.ChargeRecueBP ?? 0);

        var declareMutualise = data.Where(c => !EstMutualise(c)).Sum(c => c.ChargeATransfererMutualise ?? 0);
        var placeMutualise = data.Where(c => EstMutualise(c)).Sum(c => c.ChargeATransfererMutualise ?? 0);

        return (declareBP, receptionneBP, declareAgence, receptionneAgence, declareMutualise, placeMutualise);
    }

    private (double DeclareBP, double ReceptionneBP, double DeclareAgence, double ReceptionneAgence, double DeclareMutualise, double PlaceMutualise) GetTotal()
    {
        double dBP = 0, rBP = 0, dAg = 0, rAg = 0, dMut = 0, pMut = 0;
        foreach (var seg in Segments)
        {
            var l = GetLigne(seg);
            dBP += l.DeclareBP; rBP += l.ReceptionneBP;
            dAg += l.DeclareAgence; rAg += l.ReceptionneAgence;
            dMut += l.DeclareMutualise; pMut += l.PlaceMutualise;
        }
        return (dBP, rBP, dAg, rAg, dMut, pMut);
    }

    /// <summary>
    /// Rend une paire de cellules sous forme de badges arrondis ("pill"),
    /// cohérents avec le style des badges de pourcentage utilisés ailleurs
    /// sur le Dashboard (vert = réconcilié, rouge = écart / transfert en
    /// attente). borderGauche ajoute une séparation visuelle entre groupes.
    /// </summary>
    private RenderFragment RenderCell(double a, double b, bool applicable, bool borderGauche) => builder =>
    {
        var styleBordure = borderGauche ? "border-left:1px solid #F0F2F5;" : "";

        if (!applicable)
        {
            builder.OpenElement(0, "td");
            builder.AddAttribute(1, "style", $"text-align:center;padding:7px;color:#C7CDD4;{styleBordure}");
            builder.AddContent(2, "—");
            builder.CloseElement();
            builder.OpenElement(3, "td");
            builder.AddAttribute(4, "style", "text-align:center;padding:7px;color:#C7CDD4");
            builder.AddContent(5, "—");
            builder.CloseElement();
            return;
        }

        var ecart = Math.Abs(a - b) > 0.01;
        var couleurTexte = ecart ? "#C62828" : "#1B5E20";
        var couleurFond = ecart ? "#FDEDED" : "#EAF6EC";
        var icone = ecart ? "⚠" : "✓";

        builder.OpenElement(0, "td");
        builder.AddAttribute(1, "style", $"text-align:center;padding:6px 4px;{styleBordure}");
        builder.OpenElement(2, "span");
        builder.AddAttribute(3, "style", $"display:inline-block;min-width:44px;padding:3px 10px;border-radius:12px;background:{couleurFond};color:{couleurTexte};font-weight:700;font-size:11.5px");
        builder.AddContent(4, a.ToString("F2"));
        builder.CloseElement();
        builder.CloseElement();

        builder.OpenElement(5, "td");
        builder.AddAttribute(6, "style", "text-align:center;padding:6px 4px");
        builder.OpenElement(7, "span");
        builder.AddAttribute(8, "style", $"display:inline-block;min-width:44px;padding:3px 10px;border-radius:12px;background:{couleurFond};color:{couleurTexte};font-weight:700;font-size:11.5px");
        builder.AddContent(9, b.ToString("F2"));
        builder.AddContent(10, ecart ? " ⚠" : " ✓");
        builder.CloseElement();
        builder.CloseElement();
    };
}
