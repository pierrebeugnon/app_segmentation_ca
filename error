    /// Vert : 80-100% · Jaune : 50-80% · Rouge : &lt;50%
    /// </summary>
    private string GetPillClassConcordance(double value)
    {
        if (value >= 80) return "dash-hm-pill-good";
        if (value >= 50) return "dash-hm-pill-warn";
        return "dash-hm-pill-critical";
    }

