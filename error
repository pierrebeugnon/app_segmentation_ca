/// <summary>
/// Segments dont la répartition cible a été commencée (au moins une valeur
/// saisie) mais n'est pas terminée (la somme des cibles ne couvre pas
/// exactement la charge à répartir — "Aide à la répartition" différente
/// de OK). Les segments jamais touchés (aucune saisie) ne sont pas
/// concernés par cette règle.
/// </summary>
private List<string> GetSegmentsRepartitionIncomplete()
{
    return rows
        .Where(r => !r.IsTotal)
        .Where(r => (GetRowCibleTotal(r) ?? 0) > 0.001)
        .Where(r =>
        {
            var diff = GetCoverageDiff(r);
            return diff.HasValue && Math.Abs(diff.Value) > 0.01;
        })
        .Select(r => r.Segment)
        .ToList();
}







private async Task EnregistrerDimensionnementEtp()
{
    if (string.IsNullOrWhiteSpace(filtreAgence))
    {
        Snackbar.Add("Sélectionnez une agence avant d'enregistrer.", Severity.Warning);
        return;
    }

    var segmentsIncomplets = GetSegmentsRepartitionIncomplete();
    if (segmentsIncomplets.Any())
    {
        Snackbar.Add(
            $"Répartition incomplète sur : {string.Join(", ", segmentsIncomplets)}. " +
            "Terminez la répartition de la charge cible sur ces segments avant d'enregistrer.",
            Severity.Warning);
        return;
    }

    _isSaving = true;
