SELECT DISTINCT d.MatriculeConseiller, d.ProfilConseiller, d.SlotLabel, d.IsActuel,
       s.LibAgence AS AgenceReelleActuelle
FROM DimensionnementPortefeuilleEtp d
LEFT JOIN SegmentationDistributives s
    ON s.MatriculeConseiller = d.MatriculeConseiller
WHERE d.LibAgence = 'AGENCE STE CATHERINE LES ARRAS'
  AND d.MatriculeConseiller IS NOT NULL
ORDER BY d.MatriculeConseiller;
