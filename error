    /// <summary>
    /// Charge Totale ETP par segment ajustée : originale − (à transférer + à ajouter)
    /// </summary>
    /// <summary>
    /// Charge Totale ETP par segment ajustée :
    /// (originale − à transférer BP) + (reçue BP − à transférer mutualisé)
    /// </summary>
    private double? GetChargeTotaleAffichee(DimMatrixRow row)
    {
        if (row.IsTotal) return null;

        var original = GetRowExistantTotal(row) ?? 0;
        var transBP = _chargeATransfererBP.GetValueOrDefault(row.Segment) ?? 0;
        var recueBP = _chargeRecueBP.GetValueOrDefault(row.Segment) ?? 0;
        var transMut = _chargeATransfererMutualise.GetValueOrDefault(row.Segment) ?? 0;

        // Le sens des 3 transferts change selon le point de vue :
        // - Agence  : Agence→BP soustrait, BP→Agence ajouté, vers Mutualisé soustrait
        // - Banque Privée : Agence→BP ajouté, BP→Agence soustrait, vers Mutualisé soustrait
        // - Portefeuille Mutualisé : Agence→BP soustrait, BP→Agence soustrait, vers Mutualisé ajouté
        if (_estPortefeuilleMutualise)
            return (original - transBP - recueBP) + transMut;

        if (_estSecteurBanquePrivee)
            return (original + transBP - recueBP) - transMut;

        return (original - transBP + recueBP) - transMut;
    }

    /// <summary>
    /// Charge d'un segment en NOMBRE DE CLIENTS (vue Clients), sans aller-retour
    /// ETP lossy : base = comptage réel du segment, puis transferts (exprimés en
    /// ETP) convertis UNE seule fois en clients et arrondis à l'entier. Un résidu
    /// inférieur à un demi-client (artefact d'arrondi de saisie) est ramené à 0,
    /// pour qu'un segment dont toute la charge est sortie affiche bien 0.
    /// </summary>
    /// <summary>
    /// Répartit le nombre de clients de la charge d'un segment entre les
    /// conseillers cible, au prorata de leur ETP cible (méthode du plus fort
    /// reste). La somme des valeurs = la charge du segment (comptage réel ±
    /// transferts) exactement — pas de dérive ETP→clients cellule par cellule.
    /// </summary>
    private Dictionary<string, int> GetCibleClientsApportionne(DimMatrixRow row)
    {
        var slots = _slots.Where(s => s.IsCible).ToList();
        var result = slots.ToDictionary(s => s.Id, _ => 0);

        var etps = slots.ToDictionary(
            s => s.Id,
            s => row.EtpCibleSaisieParProfil.GetValueOrDefault(s.Id) ?? 0.0);
        var totalEtp = etps.Values.Sum();

        var target = (int)Math.Round(GetChargeTotaleClientsAffichee(row) ?? 0);
        if (totalEtp <= 0 || target <= 0) return result;

        // Parts brutes proportionnelles à l'ETP cible, puis partie entière.
        var raw = etps.ToDictionary(kv => kv.Key, kv => kv.Value / totalEtp * target);
        foreach (var id in slots.Select(s => s.Id))
            result[id] = (int)Math.Floor(raw[id]);

        // Le reste (plus fort reste) va aux plus grandes parts fractionnaires,
        // pour que la somme retombe EXACTEMENT sur la charge.
        var reste = target - result.Values.Sum();
        foreach (var id in raw
            .OrderByDescending(kv => kv.Value - Math.Floor(kv.Value))
            .ThenByDescending(kv => kv.Value)
            .Select(kv => kv.Key)
            .Take(Math.Max(0, reste)))
        {
            result[id] += 1;
        }

        return result;
    }

    private double? GetChargeTotaleClientsAffichee(DimMatrixRow row)
    {
        if (row.IsTotal) return null;

        var reel = _segmentationDistributiveFiltree?
            .Sum(x => EtpService.GetClientCountForSegment(x, row.Segment)) ?? 0;

        // Aucun transfert → comptage réel brut (aucune reconversion).
        if (!HasTransfertsForSegment(row.Segment))
            return reel;

        var taille = EtpService.GetTailleTheoriqueForSegment(row.Segment, StateService.Regles);
        if (!taille.HasValue || taille.Value <= 0)
            return reel;

        // Snap : si la charge ETP restante représente moins d'un demi-client,
        // c'est un résidu de saisie → rien ne reste réellement sur le segment.
        var restantEtp = GetChargeTotaleAffichee(row) ?? 0;
        if (Math.Abs(restantEtp) * taille.Value < 0.5)
            return 0;

        double transBP  = _chargeATransfererBP.GetValueOrDefault(row.Segment) ?? 0;
        double recueBP  = _chargeRecueBP.GetValueOrDefault(row.Segment) ?? 0;
        double transMut = _chargeATransfererMutualise.GetValueOrDefault(row.Segment) ?? 0;

        // Mêmes signes que GetChargeTotaleAffichee, selon le point de vue.
        double deltaEtp =
            _estPortefeuilleMutualise ? (transMut - transBP - recueBP) :
            _estSecteurBanquePrivee   ? (transBP  - recueBP - transMut) :
                                        (recueBP  - transBP - transMut);

        // Conversion UNIQUE ETP → clients, arrondie à l'entier.
        var deltaClients = Math.Round(deltaEtp * taille.Value);
        return Math.Max(0, reel + deltaClients);
    }

