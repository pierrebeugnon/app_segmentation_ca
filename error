    private double? GetRealEtpForSlot(string segment, ConseillerSlot slot)
    {
        var matricule = ExtractMatriculeFromSlotLabel(slot.Label);

        return EtpService.GetEtpForConseiller(
            _segmentationDistributiveFiltree,
            segment,
            matricule,
            StateService.Regles
        );
    }

    /// <summary>
    /// Nombre de clients RÉEL d'un conseiller sur un segment, compté
    /// directement depuis SegmentationDistributive — sans jamais passer
    /// par l'ETP. Utilisé pour l'affichage "Existant" en vue "Nombre de
    /// clients", pour garantir que le total ne varie jamais avec la
    /// précision de la conversion clients ↔ ETP.
    /// </summary>
    private double? GetRealClientCountForSlot(string segment, ConseillerSlot slot)
    {
        var matricule = ExtractMatriculeFromSlotLabel(slot.Label);
        if (string.IsNullOrWhiteSpace(matricule))
            return null;

        var lignes = _segmentationDistributiveFiltree
            .Where(x => string.Equals(x.MatriculeConseiller, matricule, StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (!lignes.Any())
            return null;

        var total = lignes.Sum(x => EtpService.GetClientCountForSegment(x, segment));
        return total > 0 ? (double)total : (double?)null;
    }

    /// <summary>
    /// Total réel de clients d'un conseiller, tous segments confondus —
    /// somme des comptages réels par segment, garantissant que ce total
    /// correspond exactement à la somme des cellules affichées (pas de
    /// dérive d'arrondi comme avec une conversion ETP → clients).
    /// </summary>
    private double? GetRealClientCountTotalForSlot(ConseillerSlot slot)
    {
        var vals = segments
            .Select(seg => GetRealClientCountForSlot(seg, slot))
            .Where(v => v.HasValue)
            .ToList();

        return vals.Any() ? vals.Sum(v => v!.Value) : null;
    }

    /// <summary>
    /// Total réel de clients pour TOUTE l'agence filtrée, tous conseillers
    /// confondus (y compris ceux exclus des colonnes du tableau, comme
    /// "NON REPARTI") — comptage brut direct depuis SegmentationDistributive,
    /// sur les 9 segments nommés. C'est la référence absolue du nombre de
    /// clients de l'agence, indépendante des slots affichés.
    /// </summary>
    private double? GetRealClientCountAgenceTotal()
    {
        if (_segmentationDistributiveFiltree == null || !_segmentationDistributiveFiltree.Any())
            return null;

        var total = segments.Sum(seg =>
            _segmentationDistributiveFiltree.Sum(x => EtpService.GetClientCountForSegment(x, seg)));

        return total > 0 ? (double)total : (double?)null;
    }

    /// <summary>
    /// Somme, pour un segment donné, des comptages réels de clients par
    /// conseiller (chacun déjà arrondi individuellement) — garantit que ce
    /// total correspond exactement à ce qui est visible dans les colonnes
    /// du tableau, sans arrondi indépendant sur la charge agrégée.
    /// </summary>
    private double? GetRealClientCountRowSum(string segment)
    {
        var vals = _slots
            .Select(s => GetRealClientCountForSlot(segment, s))
            .Where(v => v.HasValue)
            .ToList();

        return vals.Any() ? vals.Sum(v => v!.Value) : null;
    }

    /// <summary>
    /// Vrai si au moins un transfert manuel (BP/Agence/Mutualisé) est
    /// saisi sur ce segment. Les transferts sont exprimés uniquement en
    /// ETP et ne peuvent pas être répartis par conseiller — dans ce cas,
    /// la Colonne 1 doit rester basée sur la charge ajustée convertie,
    /// pas sur la somme des comptages réels par conseiller.
    /// </summary>
    private bool HasTransfertsForSegment(string segment)
    {
        return (_chargeATransfererBP.GetValueOrDefault(segment) ?? 0) != 0
            || (_chargeRecueBP.GetValueOrDefault(segment) ?? 0) != 0
            || (_chargeATransfererMutualise.GetValueOrDefault(segment) ?? 0) != 0;
    }

    private static string ExtractMatriculeFromSlotLabel(string label)
    {
        var idx = label.LastIndexOf('-');
        return idx >= 0 && idx < label.Length - 1
            ? label[(idx + 1)..]
            : label;
    }

    // ── Affectation depuis ReglesHypotheses ───────────────────────────────
    private int GetAssignmentLevel(string segment, string profil)
    {
        if (string.IsNullOrWhiteSpace(segment) || string.IsNullOrWhiteSpace(profil)) return 0;
        var r = StateService.Regles.ReglesAffectationSegments
            .FirstOrDefault(x => x.Segment?.Trim().Equals(segment.Trim(), StringComparison.OrdinalIgnoreCase) == true);
        if (r == null) return 0;
        if (r.ConseillerPrioritaire?.Trim().Equals(profil.Trim(), StringComparison.OrdinalIgnoreCase) == true) return 1;
        if (r.ConseillerSecondaire?.Trim().Equals(profil.Trim(),  StringComparison.OrdinalIgnoreCase) == true) return 2;
        if (r.ConseillerTertiaire?.Trim().Equals(profil.Trim(),   StringComparison.OrdinalIgnoreCase) == true) return 3;
        return 0;
    }

    private static string GetMergedCellStyle(int level, bool isTotal, bool isGreyed = false)
    {
        if (isGreyed) return "background:#ECECEC;opacity:0.5";
        if (isTotal) return "";
        return level switch
        {
            1 => "background:#1A6B3C;color:white",
            2 => "background:#52A86B;color:white",
            3 => "background:#C3E6CB;color:#1A4E6B",
            _ => ""
        };
    }

