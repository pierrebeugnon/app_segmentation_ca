private List<SegmentationDistributiveData> _segmentationDistributive = new();


// 2bis. Charge les données brutes pour l'agrégation du nombre de clients par segment
_segmentationDistributive = await Http.GetFromJsonAsync<List<SegmentationDistributiveData>>(
    "api/SegmentationDistributive"
) ?? new();



// ── Charge ETP théorique (vision cible) = nb clients du segment (agrégé
// depuis SegmentationDistributive) ÷ taille théorique calculée ci-dessus ──
var nbClientsSegment = segmentNonRenseigne
    ? 0
    : _segmentationDistributive.Sum(x => EtpService.GetClientCountForSegment(x, context.SegmentCouvert));
