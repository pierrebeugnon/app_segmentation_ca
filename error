namespace Segmentation.Application.Common
{
	/// <summary>
	/// Normalisation centralisée des libellés de profils conseillers.
	/// Fusionne les variantes d'écriture d'un même métier (codes courts
	/// issus de SegmentationDistributive, anciens intitulés...) vers un
	/// libellé canonique unique, utilisé partout dans l'application pour
	/// éviter la dilution de l'info entre plusieurs écritures du même
	/// métier.
	///
	/// Liste des codes bruts réellement présents en base
	/// (vérifiée par requête SQL le 2026-08-05) :
	///   CH.PATRIMON, CO.GESPAT, CONS.CLIENT, CONS.COMMER,
	///   CONS.PRIVE, DIR.PATRIMO, DIR.SECTEUR, RESP.AGENCE
	/// </summary>
	public static class ProfilNormalizer
	{
		private static readonly Dictionary<string, string> _normalisation =
			new(StringComparer.OrdinalIgnoreCase)
			{
				// RCP (ex Chargé de Patrimoine)
				["CH.PATRIMON"] = "RCP",
				["RCP"] = "RCP",

				// CGP (ex Co-Gestionnaire de Patrimoine)
				["CO.GESPAT"] = "CGP",
				["CGP"] = "CGP",

				// Conseiller clientèle
				["CONS.CLIENT"] = "CONSEILLER CLIENTELE",
				["CONS.CLIENTELE"] = "CONSEILLER CLIENTELE",
				["CONSEILLER CLIENTELE"] = "CONSEILLER CLIENTELE",

				// Conseiller commercial
				["CONS.COMMER"] = "CONSEILLER COMMERCIAL",
				["CONS.COMMERCIAL"] = "CONSEILLER COMMERCIAL",
				["CONSEILLER COMMERCIAL"] = "CONSEILLER COMMERCIAL",

				// Banquier privé (ex Conseiller Privé)
				["CONS.PRIVE"] = "BANQUIER PRIVÉ",
				["BANQUIER PRIVE"] = "BANQUIER PRIVÉ",
				["BANQUIER PRIVÉ"] = "BANQUIER PRIVÉ",

				// Directeur Banque Privée (ex Directeur de Patrimoine)
				["DIR.PATRIMO"] = "DIRECTEUR BANQUE PRIVEE",
				["DIRECTEUR BANQUE PRIVEE"] = "DIRECTEUR BANQUE PRIVEE",

				// DS / DSD (ex Directeur de Secteur)
				["DIR.SECTEUR"] = "DS / DSD",
				["DS / DSD"] = "DS / DSD",

				// Responsable d'agence
				["RESP.AGENCE"] = "RESP. AGENCE",
				["RESP. AGENCE"] = "RESP. AGENCE",

				// Conseiller d'accueil (non présent dans les codes bruts
				// actuels, mais référencé dans les règles d'affectation
				// par défaut — conservé par sécurité)
				["CONS.ACCUEIL"] = "CONSEILLER D'ACCUEIL",
				["CONSEILLER D'ACCUEIL"] = "CONSEILLER D'ACCUEIL",
			};

		private static readonly Dictionary<string, string> _ligneMetier =
			new(StringComparer.OrdinalIgnoreCase)
			{
				["DIRECTEUR BANQUE PRIVEE"] = "banque privée",
				["BANQUIER PRIVÉ"] = "banque privée",
				["CGP"] = "banque privée",

				["RESP. AGENCE"] = "retail",
				["RCP"] = "retail",
				["CONSEILLER CLIENTELE"] = "retail",
				["CONSEILLER COMMERCIAL"] = "retail",
				["CONSEILLER D'ACCUEIL"] = "retail",
				["DS / DSD"] = "retail",
			};

		/// <summary>
		/// Retourne le libellé canonique d'un profil.
		/// Si aucune correspondance : renvoie le libellé nettoyé tel quel.
		/// </summary>
		public static string Normaliser(string? profilBrut)
		{
			if (string.IsNullOrWhiteSpace(profilBrut))
				return string.Empty;

			var trimmed = profilBrut.Trim();
			return _normalisation.TryGetValue(trimmed, out var canonique)
				? canonique
				: trimmed;
		}

		/// <summary>
		/// Ligne métier (banque privée / retail) d'un profil déjà normalisé.
		/// Retombe sur "retail" si le profil canonique n'est pas connu.
		/// </summary>
		public static string GetLigneMetier(string profilCanonique)
		{
			return _ligneMetier.TryGetValue(profilCanonique, out var lm)
				? lm
				: "retail";
		}
	}
}
