SELECT 
    SegmentationDistributiveID,
    LibRegion,
    CodeRegion,
    LibSecteur,
    LibAgence,
    CodeAgence,
    MatriculeConseiller,
    TypeConseiller,
    HDGPremiumPotentiel,
    HDGPremiumStandard,
    HDGPotentiel,
    HDGSeniorEpargnant,
    HDGStandard,
    CIPotentiel,
    CIStandard,
    GPPotentiel,
    GPStandard,
    NonSegmente,
    NonClasse,
    (HDGPremiumPotentiel + HDGPremiumStandard + HDGPotentiel + HDGSeniorEpargnant 
        + HDGStandard + CIPotentiel + CIStandard + GPPotentiel + GPStandard 
        + NonSegmente + NonClasse) AS TotalClientsLigne
FROM SegmentationDistributive
WHERE LibAgence IS NULL OR LTRIM(RTRIM(LibAgence)) = ''
ORDER BY LibRegion, LibSecteur, TypeConseiller;
