_slots = BuildSlots();
            rows = BuildRows();

            RecalcTotal();

            // Tente de restaurer une sauvegarde existante pour cette agence.
            // Doit s'exécuter AVANT le calcul de `profils` ci-dessous : c'est
            // elle qui peut ajouter à _slots des conseillers créés
            // manuellement lors d'une sauvegarde précédente (sans matricule,
            // donc absents de BuildSlots()).
            await RestaurerSauvegardeEtp();

            // Un profil obtient une colonne dans le tableau de charges dès
            // qu'au moins un conseiller de ce type existe dans _slots — que
            // ce soit un conseiller réel (matricule) ou restauré depuis une
            // sauvegarde précédente (ajouté manuellement).
            profils = _slots
                .Select(s => s.Profil)
                .Where(p => !string.IsNullOrWhiteSpace(p))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(p => p)
                .ToList();

            filteredRows = rows.ToList();
