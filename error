private async Task ExportExcel()
{
    var data = await DimensionnementEtpService.GetAllAsync();

    if (data is null || (!data.Lignes.Any() && !data.Charges.Any()))
    {
        Snackbar.Add("Aucune donnée de dimensionnement à exporter.", Severity.Warning);
        return;
    }

    var sb = new System.Text.StringBuilder();

    sb.AppendLine("DIMENSIONNEMENT PORTEFEUILLE ETP");
    sb.AppendLine("Région;Secteur;Agence;Segment;Profil Conseiller;Matricule;Label;Actuel;Cible;ETP Existant;ETP Cible;Capacité ETP Actuel;Capacité ETP Cible");
    foreach (var l in data.Lignes)
        sb.AppendLine($"{l.LibRegion};{l.LibSecteur};{l.LibAgence};{l.Segment};{l.ProfilConseiller};{l.MatriculeConseiller};{l.SlotLabel};{(l.IsActuel ? "Oui" : "Non")};{(l.IsCible ? "Oui" : "Non")};{l.EtpExistant:F4};{l.EtpCible:F4};{l.CapaciteEtpActuel:F4};{l.CapaciteEtpCible:F4}");

    sb.AppendLine();
    sb.AppendLine("CHARGES MANUELLES PAR SEGMENT");
    sb.AppendLine("Agence;Segment;Charge à transférer BP;Charge reçue BP;Charge à transférer mutualisé");
    foreach (var c in data.Charges)
        sb.AppendLine($"{c.LibAgence};{c.Segment};{c.ChargeATransfererBP:F4};{c.ChargeRecueBP:F4};{c.ChargeATransfererMutualise:F4}");

    var csv = sb.ToString();
    var fileName = $"dimensionnement_portefeuille_CA_{DateTime.Now:yyyyMMdd_HHmm}.csv";
    await JS.InvokeVoidAsync("downloadCsvFile", fileName, csv);
}
