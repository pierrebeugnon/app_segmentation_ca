private static int GetProfilRank(string? profil) => NormalizeProfilKey(profil) switch
{
    // Agence
    "CONSEILLER COMMERCIAL" => 1,
    "CONSEILLER CLIENTELE" => 2,
    "RCP" => 3,
    "RESP AGENCE" => 4,
    "DS / DSD" => 5,

    // Banque privée
    "CGP" => 21,
    "BANQUIER PRIVE" => 22,
    "DIRECTEUR BANQUE PRIVEE" => 23,

    "CONSEILLER D ACCUEIL" => 30,

    // Tout profil non reconnu (ex. anciens libellés legacy en base
    // comme "DIR. BP") passe en fin de liste plutôt que de faire
    // planter le rendu de la page.
    _ => 99
};
