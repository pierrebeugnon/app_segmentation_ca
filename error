    private double? GetTauxRotationForRow(DimMatrixRow row)
    {
        if (row.IsTotal) return null;

        // Charge ETP ajustée du segment (existant ± transferts BP/Agence/Mutualisé).
        var chargeAjustee = Math.Round(GetChargeTotaleAffichee(row) ?? 0, 2);
        if (chargeAjustee <= 0) return null;

        // Rotation = somme des gains uniquement (cible > existant) par
        // conseiller — les pertes ne sont pas comptées, pour éviter de compter
        // le même mouvement en double (un gain d'un côté = une perte de l'autre).
        var gains = _slots.Sum(s =>
            Math.Max(0,
                Math.Round(row.EtpCibleSaisieParProfil.GetValueOrDefault(s.Id) ?? 0, 2)
                - Math.Round(row.EtpParProfil.GetValueOrDefault(s.Id) ?? 0, 2)
            ));

        return Math.Round(gains, 2) / chargeAjustee * 100.0;
    }

    private double? GetTauxRotationExistant(DimMatrixRow row)
    {
        if (row.IsTotal) return null;
        var cible = Math.Round(GetRowCibleTotal(row) ?? 0, 2);
        var exist = Math.Round(GetRowExistantTotal(row) ?? 0, 2);
        if (exist <= 0) return null;
        return Math.Round(cible - exist, 2) / exist * 100.0;
    }

