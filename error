private double? GetTotalTauxRotation()
{
    var cible = rows.Where(r => !r.IsTotal).Sum(r => GetRowCibleTotal(r) ?? 0);
    if (cible <= 0) return null;

    var mouvement = rows.Where(r => !r.IsTotal)
        .Sum(r => _slots.Sum(s =>
            Math.Abs(
                Math.Round(r.EtpCibleSaisieParProfil.GetValueOrDefault(s.Id) ?? 0, 2)
                - Math.Round(r.EtpParProfil.GetValueOrDefault(s.Id) ?? 0, 2)
            )));

    return Math.Round(mouvement, 2) / cible * 100.0;
}
